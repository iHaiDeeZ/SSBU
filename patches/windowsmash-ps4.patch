+/* The disk cache's files in one ("<cache dir>.pak", the SSBU port's scripts/pack-shadercache.py): a header, a table of
+ * the files' names (FNV-1a of each, sorted) with where each one's bytes are, and the bytes. Where a look-up in a
+ * folder of tens of thousands of files is slow - the PS4's: the renderer waited in stat 30% of its time while a match
+ * started (v00.13), the compiler threads in open 17% - a file of the pack is found in the table and read at its
+ * place. The folder is still asked for what the pack has not (shaders compiled since), and written to. */
+typedef struct { u64 name, offset; u32 size, pad; } PackEntry;
+static PackEntry *pack_index;
+static HANDLE pack_file = INVALID_HANDLE_VALUE;
+
+static void pack_open(void) {
+    char path[1100];
+    snprintf(path, sizeof path, "%s.pak", cache_dir());
+    HANDLE h = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_FLAG_RANDOM_ACCESS, NULL);
+    if (h == INVALID_HANDLE_VALUE) return;
+    struct { char magic[8]; u32 version, count; } head;
+    DWORD got = 0, want;
+    PackEntry *index = NULL;
+    if (ReadFile(h, &head, sizeof head, &got, NULL) && got == sizeof head && !memcmp(head.magic, "SSBUDXBC", 8) && head.version == 1 &&
+        (index = malloc((size_t)head.count * sizeof *index)) &&
+        ReadFile(h, index, want = head.count * (DWORD)sizeof *index, &got, NULL) && got == want) {
+        pack_index = index;
+        pack_count = head.count;
+        pack_file = h;
+        fprintf(stderr, "[gfx] shader cache pack: %u programs (%s)\n", pack_count, path);
+        return;
+    }
+    fprintf(stderr, "[gfx] shader cache pack %s: not one this runtime reads\n", path);
+    free(index);
+    CloseHandle(h);
+}
+
+static const PackEntry *pack_find(const char *path) {
+    if (!pack_count) return NULL;
+    const char *base = strrchr(path, '/');
+    base = base ? base + 1 : path;
+    u64 name = shader_program_hash((const u8 *)base, (u32)strlen(base));
+    u32 lo = 0, hi = pack_count;
+    while (lo < hi) {
+        u32 mid = (lo + hi) / 2;
+        if (pack_index[mid].name < name) lo = mid + 1; else hi = mid;
+    }
+    return lo < pack_count && pack_index[lo].name == name ? &pack_index[lo] : NULL;
+}
+
+/* Whether a shader's DXBC was kept: in the pack (path: its name in the folder), else in the new folder (path: that
+ * file), else in the folder. */
+static int cache_find(const Shader *s, char *path, size_t n) {
+    cache_path(s, path, n);
+    if (pack_find(path)) return 1;
+    if (pack_count) {
+        char beside[1200];
+        new_path(s, beside, sizeof beside);
+        if (GetFileAttributesA(beside) != INVALID_FILE_ATTRIBUTES) { snprintf(path, n, "%s", beside); return 1; }
+    }
+    return GetFileAttributesA(path) != INVALID_FILE_ATTRIBUTES;

+#!/usr/bin/env python3
+"""vkd3d-shader (HLSL -> DXBC: D3DCompile on the PS4, runtime/linux/d3dcompile_vkd3d.c) for the PS4, as a static
+library: tools/linux/build_vkd3d.py's build with the PS4 toolchain (tools/ps4/build_ps4.py's flags).
+
+Usage: build_vkd3d_ps4.py <vkd3d source> <SPIRV-Headers include dir> <out dir>
+The parsers are made by the system's bison and flex."""
+import glob
+import os
+import subprocess
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import build_ps4  # noqa: E402
+
+SRC, SPIRV, OUT = (os.path.abspath(a) for a in sys.argv[1:4])
+GEN = os.path.join(OUT, "gen")
+CONFIG = """#define HAVE_ATOMIC_EXCHANGE_N 1
+#define HAVE_BUILTIN_ADD_OVERFLOW 1
+#define HAVE_BUILTIN_CLZ 1
+#define HAVE_BUILTIN_CTZ 1
+#define HAVE_BUILTIN_POPCOUNT 1
+#define HAVE_INTTYPES_H 1
+#define HAVE_STDINT_H 1
+#define HAVE_STDIO_H 1
+#define HAVE_STDLIB_H 1
+#define HAVE_STRING_H 1
+#define HAVE_SYNC_ADD_AND_FETCH 1
+#define HAVE_SYNC_BOOL_COMPARE_AND_SWAP 1
+#define HAVE_SPIRV_UNIFIED1_SPIRV_H 1
+#define HAVE_SPIRV_UNIFIED1_GLSL_STD_450_H 1
+#define HAVE_PTHREAD_H 1
+#define HAVE_STRINGS_H 1
+#define HAVE_SYS_STAT_H 1
+#define HAVE_SYS_TYPES_H 1
+#define HAVE_UNISTD_H 1
+#define HAVE_WCHAR_H 1
+#define PACKAGE_NAME "vkd3d"
+#define PACKAGE_VERSION "2.1"
+#define PACKAGE_STRING "vkd3d 2.1"
+#define PACKAGE_BUGREPORT ""
+#define PACKAGE_TARNAME "vkd3d"
+#define PACKAGE_URL ""
+#define VERSION "2.1"
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE 1
+#endif
+"""
+
+
+def main():
+    os.makedirs(GEN, exist_ok=True)
+    shader_dir = os.path.join(SRC, "libs", "vkd3d-shader")
+    for name in ("hlsl", "preproc"):
+        if not os.path.exists(os.path.join(GEN, name + ".tab.c")):
+            subprocess.run(["bison", "-d", "-o", name + ".tab.c", os.path.join(shader_dir, name + ".y")], cwd=GEN, check=True)
+        if not os.path.exists(os.path.join(GEN, name + ".yy.c")):
+            subprocess.run(["flex", "-o", name + ".yy.c", os.path.join(shader_dir, name + ".l")], cwd=GEN, check=True)
+    with open(os.path.join(GEN, "vkd3d_version.h"), "w") as f:
+        f.write('#define VKD3D_VCS_ID ""\n')
+    inc = os.path.join(OUT, "include")
+    os.makedirs(inc, exist_ok=True)
+    with open(os.path.join(inc, "config.h"), "w") as f:
+        f.write(CONFIG)
+    shader = sorted(glob.glob(os.path.join(shader_dir, "*.c")))
+    common = [os.path.join(SRC, "libs", "vkd3d-common", n) for n in ("debug.c", "error.c", "memory.c", "utf8.c")]
+    gen = [os.path.join(GEN, n) for n in ("hlsl.tab.c", "hlsl.yy.c", "preproc.tab.c", "preproc.yy.c")]
+    flags = ["-I", inc, "-I", GEN, "-I", os.path.join(SRC, "include"), "-I", os.path.join(SRC, "include", "private"),
+             "-I", shader_dir, "-I", SPIRV, "-DLIBVKD3D_SHADER_SOURCE", "-DVKD3D_NO_VULKAN_H",
+             "-DVKD3D_DEBUG_ENV=VKD3D_SHADER_DEBUG", "-DNDEBUG", "-std=gnu11", "-include",
+             os.path.join(build_ps4.RUNTIME, "ps4", "include", "ps4_compat.h")]
+    srcs = shader + common + gen
+    jobs = [(s, os.path.join(OUT, "obj", os.path.basename(s)[:-2] + ".o"), "-O2", flags) for s in srcs]
+    if not build_ps4.compile_all(jobs, "vkd3d-shader"):
+        return False
+    lib = os.path.join(OUT, "libvkd3d-shader.a")
+    if os.path.exists(lib):
+        os.remove(lib)
+    subprocess.run(["llvm-ar-21", "rcs", lib, *[j[1] for j in jobs]], check=True)
+    print(f"{lib} ({os.path.getsize(lib) / 1048576:.1f} MB)")
+    return True
+
+
+if __name__ == "__main__":
+    sys.exit(0 if main() else 1)

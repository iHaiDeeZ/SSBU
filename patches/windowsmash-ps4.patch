@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""The codecs for the PS4 - libopus (the game's music) and libvpx's VP9 decoder (its movies) - from third_party/, as
+tools/codec_libs.py builds them for macOS (build_static): <out>/codecs/libopus.a and libvpx.a, with the PS4
+toolchain's flags (tools/ps4/build_ps4.py). opus in portable C (Windows' x86 build presumes AVX2, which the PS4's
+Jaguar lacks); libvpx with its x86-64 configuration, in plain C as everywhere.
+
+Usage: build_codecs_ps4.py [--out <dir>] [--force]"""
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+sys.path.insert(0, os.path.dirname(HERE))
+import build_ps4  # noqa: E402
+import codec_libs as cl  # noqa: E402
+
+
+def main():
+    out = os.path.abspath(build_ps4.arg("--out", os.path.join(build_ps4.HOME, "ssbu-build", "build")))
+    codecs = os.path.join(out, "codecs")
+    os.makedirs(codecs, exist_ok=True)
+    libs = {
+        "opus": (os.path.join(codecs, "libopus.a"), cl.OPUS, cl.OPUS_FOLDERS_ARM64, cl.OPUS_INCLUDES, cl.OPUS_DEFINES_ARM64, cl.have_opus),
+        "libvpx": (os.path.join(codecs, "libvpx.a"), cl.VPX, cl.VPX_FOLDERS, cl.VPX_INCLUDES, (), cl.have_vpx),
+    }
+    for name, (lib, root, folders, includes, defines, have) in libs.items():
+        if not have():
+            print(f"{name}: no sources in {root}")
+            continue
+        flags = cl.static_flags(build_ps4.CFLAGS, root, includes, defines)
+        if "--force" in sys.argv or not os.path.isfile(lib) or not cl.is_current(lib, root, folders, includes):
+            cl.build_static_lib(name, lib, root, folders, flags, build_ps4.CLANG, "llvm-ar-21", build_ps4.JOBS, print)
+        print(f"{name}: {lib}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

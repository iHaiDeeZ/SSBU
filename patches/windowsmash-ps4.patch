@@ -0,0 +1,238 @@
+/* The NROs' code on the PS4: a library each (tools/ps4/build_ps4.py: dump/nro/<name>.so), loaded when the
+ * game loads the NRO (host.c rt_load_nro), into memory that runs code (memory.c rt_ps4_exec_alloc: direct
+ * memory mapped twice, or flexible memory - whichever this console runs code from).
+ *
+ * The eboot's code goes into flexible memory, of which an app has ~450 MiB: the game's own modules (main,
+ * sdk, subsdk0: ~190 MB) fit there, its 98 NROs (~1 GB: fighters, items, modes) do not - and a match needs a
+ * few of them at a time. The eboot knows each NRO by its module table without the code (gen/nro_table.c:
+ * addresses, sizes, build id, counts); this file maps the NRO's library, binds it and returns the whole table.
+ *
+ * A minimal dynamic loader: the library's segments copied in at one base; its relocations applied - relative
+ * ones, and symbol ones against the eboot's exports (gen/ps4_exports.c: rt_lookup, the C++ runtime, ...)
+ * first and the library's own definitions second, as an executable's symbols win in a dynamic link (the C++
+ * typeinfo a catch matches by address must be the eboot's, whose code throws); its unwind tables found by
+ * the unwinder through its .eh_frame_hdr (guest C++ exceptions unwind through NRO code: "unwind tables"
+ * below); its initialisers run.
+ * Nothing is unloaded. */
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "../host.h"
+#include "../module.h"
+
+typedef struct { unsigned char e_ident[16]; uint16_t e_type, e_machine; uint32_t e_version; uint64_t e_entry, e_phoff, e_shoff;
+                 uint32_t e_flags; uint16_t e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx; } Ehdr;
+typedef struct { uint32_t p_type, p_flags; uint64_t p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align; } Phdr;
+typedef struct { int64_t d_tag; uint64_t d_val; } Dyn;
+typedef struct { uint32_t st_name; uint8_t st_info, st_other; uint16_t st_shndx; uint64_t st_value, st_size; } Sym;
+typedef struct { uint64_t r_offset, r_info; int64_t r_addend; } Rela;
+
+enum { PT_LOAD = 1, PT_DYNAMIC = 2, PT_GNU_EH_FRAME = 0x6474e550 };
+enum { DT_NULL = 0, DT_PLTRELSZ = 2, DT_HASH = 4, DT_STRTAB = 5, DT_SYMTAB = 6, DT_RELA = 7, DT_RELASZ = 8, DT_INIT = 12,
+       DT_JMPREL = 23, DT_INIT_ARRAY = 25, DT_INIT_ARRAYSZ = 27 };
+enum { R_NONE = 0, R_64 = 1, R_GLOB_DAT = 6, R_JUMP_SLOT = 7, R_RELATIVE = 8 };
+
+typedef struct Ps4Export { const char *name; const void *addr; } Ps4Export;
+extern const Ps4Export ps4_exports[];
+extern const unsigned ps4_export_count;
+
+static const void *eboot_symbol(const char *name, int *found) {
+    unsigned a = 0, b = ps4_export_count;
+    while (a < b) {
+        unsigned m = (a + b) / 2;
+        int c = strcmp(ps4_exports[m].name, name);
+        if (!c) { *found = ps4_exports[m].addr != NULL; return ps4_exports[m].addr; }
+        if (c < 0) a = m + 1; else b = m;
+    }
+    *found = 0;
+    return NULL;
+}
+
+static int read_at(int fd, void *buf, size_t n, off_t at) {
+    for (size_t done = 0; done < n;) {
+        ssize_t r = pread(fd, (char *)buf + done, n - done, at + (off_t)done);
+        if (r <= 0) return 0;
+        done += (size_t)r;
+    }
+    return 1;
+}
+
+/* A DWARF pointer as .eh_frame_hdr encodes eh_frame_ptr (pc-relative or absolute, 4 or 8 bytes). */
+static uintptr_t read_encoded(const uint8_t *p, uint8_t enc) {
+    uintptr_t v;
+    switch (enc & 0x0F) {
+    case 0x03: v = *(const uint32_t *)p; break;
+    case 0x0B: v = (uintptr_t)(intptr_t)*(const int32_t *)p; break;
+    case 0x04: case 0x0C: v = (uintptr_t)*(const uint64_t *)p; break;
+    default: return 0;
+    }
+    if ((enc & 0x70) == 0x10) v += (uintptr_t)p;   /* pcrel */
+    return v;
+}
+
+/* ---- unwind tables -----------------------------------------------------------------------------
+ * libunwind (OpenOrbis's, built for bare metal) asks this for the unwind tables of a code address. Its
+ * own answer is the eboot's tables for every address: for a frame of an NRO library's code it searched
+ * the eboot's index, then went through the eboot's whole .eh_frame (7.7 MB) one entry at a time, and
+ * only then looked at the entries registered for the libraries (__unw_add_dynamic_fde: a list it also
+ * goes through one at a time, ~100,000 of them with a match's fighters loaded). Guest C++ exceptions
+ * unwind through the fighters' code all through a match: v00.10's main thread spent 99% of its time
+ * there (1-2 frames a second). Here: the eboot's tables, or the library's own, both found through
+ * their .eh_frame_hdr's sorted table (binary search). (The layout is that libunwind's: dso_base, the
+ * .eh_frame and its length, the .eh_frame_hdr and its length.) */
+typedef struct { uintptr_t dso_base, eh_frame, eh_frame_length, eh_frame_hdr, eh_frame_hdr_length; } UnwindSections;
+extern char __text_start[], __eh_frame_start[], __eh_frame_end[], __eh_frame_hdr_start[], __eh_frame_hdr_end[];
+
+#define MAX_LIBS 128
+static struct { uintptr_t start, end, eh_frame, hdr, hdr_length; } libs[MAX_LIBS];
+static int nlibs;
+
+_Bool ps4_find_unwind_sections(void *self, uintptr_t pc, UnwindSections *info)
+    __asm__("_ZN9libunwind17LocalAddressSpace18findUnwindSectionsEmRNS_18UnwindInfoSectionsE");
+_Bool ps4_find_unwind_sections(void *self, uintptr_t pc, UnwindSections *info) {
+    (void)self;
+    if (pc >= (uintptr_t)__text_start && pc < (uintptr_t)__eh_frame_start) {   /* the eboot (its code and read-only data) */
+        info->dso_base = 0;
+        info->eh_frame = (uintptr_t)__eh_frame_start;
+        info->eh_frame_length = (uintptr_t)(__eh_frame_end - __eh_frame_start);
+        info->eh_frame_hdr = (uintptr_t)__eh_frame_hdr_start;
+        info->eh_frame_hdr_length = (uintptr_t)(__eh_frame_hdr_end - __eh_frame_hdr_start);
+        return 1;
+    }
+    int n = __atomic_load_n(&nlibs, __ATOMIC_ACQUIRE);
+    for (int i = 0; i < n; i++)
+        if (pc >= libs[i].start && pc < libs[i].end) {
+            info->dso_base = libs[i].start;
+            info->eh_frame = libs[i].eh_frame;
+            info->eh_frame_length = libs[i].end - libs[i].eh_frame;
+            info->eh_frame_hdr = libs[i].hdr;
+            info->eh_frame_hdr_length = libs[i].hdr_length;
+            return 1;
+        }
+    return 0;   /* (no tables: the unwinder stops there) */
+}
+
+/* A library's tables, for the lookup above; its count of FDEs (the index's), 0 without one. */
+static u32 add_unwind(uint8_t *run, const Phdr *eh, uint64_t span) {
+    const uint8_t *hdr = run + eh->p_vaddr;
+    if (hdr[0] != 1 || hdr[3] != 0x3B) return 0;   /* (version 1, a table of datarel sdata4 pairs) */
+    uintptr_t frame = read_encoded(hdr + 4, hdr[1]);
+    u32 count = (u32)read_encoded(hdr + 8, hdr[2]);
+    if (!frame || nlibs == MAX_LIBS) return 0;
+    int i = nlibs;
+    libs[i].start = (uintptr_t)run;
+    libs[i].end = (uintptr_t)run + span;
+    libs[i].eh_frame = frame;
+    libs[i].hdr = (uintptr_t)hdr;
+    libs[i].hdr_length = eh->p_memsz;
+    __atomic_store_n(&nlibs, i + 1, __ATOMIC_RELEASE);   /* (one loader at a time: nn::ro's) */
+    return count;
+}
+
+const RtModule *rt_ps4_load_nro_code(const RtModule *stub) {
+    char path[512], table[160];
+    snprintf(path, sizeof path, "%s/../nro/%s.so", rt_data_dir, stub->name);

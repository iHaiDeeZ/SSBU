 static ssize_t read_some(int fd, void *buf, size_t n, off_t offset, int positional) {
-#ifdef __APPLE__   /* (macOS: always the protecting watch) */
+#ifdef RT_PLATFORM_MEMORY   /* (macOS and the PS4: always the protecting watch; the PS4's memory is also mapped on first touch) */
     off_t start = positional ? offset : lseek(fd, 0, SEEK_CUR);
     ssize_t r = positional ? pread(fd, buf, n, offset) : read(fd, buf, n);
     if (r >= 0 || errno != EFAULT) return r;
@@ -1384,6 +1485,8 @@ errno_t rand_s(unsigned int *value) {
 #ifdef __APPLE__
     arc4random_buf(value, sizeof *value);
     return 0;
+#elif defined(__ORBIS__)   /* (the port's getentropy: sceRandom) */
+    return getentropy(value, sizeof *value) == 0 ? 0 : EIO;
 #else
     return getrandom(value, sizeof *value, 0) == (ssize_t)sizeof *value ? 0 : EIO;
 #endif
@@ -1397,6 +1500,10 @@ void ExitProcess(UINT code) {
 #ifdef __APPLE__   /* (the program's Mach-O header: where it is loaded) */
 HMODULE GetModuleHandleW(LPCWSTR name) { return name ? NULL : (HMODULE)&_mh_execute_header; }
 HMODULE GetModuleHandleA(LPCSTR name) { return name ? NULL : (HMODULE)&_mh_execute_header; }
+#elif defined(__ORBIS__)   /* (the OpenOrbis link.x: the start of the eboot's code) */
+extern char __text_start[];
+HMODULE GetModuleHandleW(LPCWSTR name) { return name ? NULL : (HMODULE)__text_start; }
+HMODULE GetModuleHandleA(LPCSTR name) { return name ? NULL : (HMODULE)__text_start; }
 #else
 extern char __executable_start[];
 HMODULE GetModuleHandleW(LPCWSTR name) { return name ? NULL : (HMODULE)__executable_start; }
diff --git a/runtime/ps4/elfload.c b/runtime/ps4/elfload.c
new file mode 100644
index 0000000..44d9b6c
--- /dev/null
+++ b/runtime/ps4/elfload.c
@@ -0,0 +1,196 @@
+/* The NROs' code on the PS4: a library each (tools/ps4/build_ps4.py: dump/nro/<name>.so), loaded when the
+ * game loads the NRO (host.c rt_load_nro), into memory that runs code (memory.c rt_ps4_exec_alloc: direct
+ * memory mapped twice, or flexible memory - whichever this console runs code from).
+ *
+ * The eboot's code goes into flexible memory, of which an app has ~450 MiB: the game's own modules (main,
+ * sdk, subsdk0: ~190 MB) fit there, its 98 NROs (~1 GB: fighters, items, modes) do not - and a match needs a
+ * few of them at a time. The eboot knows each NRO by its module table without the code (gen/nro_table.c:
+ * addresses, sizes, build id, counts); this file maps the NRO's library, binds it and returns the whole table.
+ *
+ * A minimal dynamic loader: the library's segments copied in at one base; its relocations applied - relative
+ * ones, and symbol ones against the eboot's exports (gen/ps4_exports.c: rt_lookup, the C++ runtime, ...)
+ * first and the library's own definitions second, as an executable's symbols win in a dynamic link (the C++
+ * typeinfo a catch matches by address must be the eboot's, whose code throws); its unwind tables registered
+ * with the unwinder, one FDE at a time (guest C++ exceptions unwind through NRO code); its initialisers run.
+ * Nothing is unloaded. */
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "../host.h"
+#include "../module.h"
+
+typedef struct { unsigned char e_ident[16]; uint16_t e_type, e_machine; uint32_t e_version; uint64_t e_entry, e_phoff, e_shoff;
+                 uint32_t e_flags; uint16_t e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx; } Ehdr;
+typedef struct { uint32_t p_type, p_flags; uint64_t p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align; } Phdr;
+typedef struct { int64_t d_tag; uint64_t d_val; } Dyn;
+typedef struct { uint32_t st_name; uint8_t st_info, st_other; uint16_t st_shndx; uint64_t st_value, st_size; } Sym;
+typedef struct { uint64_t r_offset, r_info; int64_t r_addend; } Rela;
+
+enum { PT_LOAD = 1, PT_DYNAMIC = 2, PT_GNU_EH_FRAME = 0x6474e550 };
+enum { DT_NULL = 0, DT_PLTRELSZ = 2, DT_HASH = 4, DT_STRTAB = 5, DT_SYMTAB = 6, DT_RELA = 7, DT_RELASZ = 8, DT_INIT = 12,
+       DT_JMPREL = 23, DT_INIT_ARRAY = 25, DT_INIT_ARRAYSZ = 27 };
+enum { R_NONE = 0, R_64 = 1, R_GLOB_DAT = 6, R_JUMP_SLOT = 7, R_RELATIVE = 8 };
+
+typedef struct Ps4Export { const char *name; const void *addr; } Ps4Export;
+extern const Ps4Export ps4_exports[];
+extern const unsigned ps4_export_count;
+
+void __unw_add_dynamic_fde(uintptr_t fde);   /* (libunwind) */
+
+static const void *eboot_symbol(const char *name, int *found) {
+    unsigned a = 0, b = ps4_export_count;
+    while (a < b) {
+        unsigned m = (a + b) / 2;
+        int c = strcmp(ps4_exports[m].name, name);
+        if (!c) { *found = ps4_exports[m].addr != NULL; return ps4_exports[m].addr; }
+        if (c < 0) a = m + 1; else b = m;
+    }
+    *found = 0;
+    return NULL;
+}
+
+static int read_at(int fd, void *buf, size_t n, off_t at) {
+    for (size_t done = 0; done < n;) {
+        ssize_t r = pread(fd, (char *)buf + done, n - done, at + (off_t)done);
+        if (r <= 0) return 0;
+        done += (size_t)r;
+    }
+    return 1;
+}
+
+/* A DWARF pointer as .eh_frame_hdr encodes eh_frame_ptr (pc-relative or absolute, 4 or 8 bytes). */
+static uintptr_t read_encoded(const uint8_t *p, uint8_t enc) {
+    uintptr_t v;
+    switch (enc & 0x0F) {
+    case 0x03: v = *(const uint32_t *)p; break;
+    case 0x0B: v = (uintptr_t)(intptr_t)*(const int32_t *)p; break;
+    case 0x04: case 0x0C: v = (uintptr_t)*(const uint64_t *)p; break;
+    default: return 0;
+    }
+    if ((enc & 0x70) == 0x10) v += (uintptr_t)p;   /* pcrel */
+    return v;
+}
+
+static u32 register_unwind(uint8_t *base, const Phdr *eh, uint64_t span) {
+    const uint8_t *hdr = base + eh->p_vaddr;
+    if (hdr[0] != 1) return 0;
+    const uint8_t *frame = (const uint8_t *)read_encoded(hdr + 4, hdr[1]), *end = base + span;
+    u32 n = 0;
+    while (frame && frame + 8 <= end) {
+        uint64_t len = *(const uint32_t *)frame;
+        const uint8_t *body = frame + 4;
+        if (!len) break;
+        if (len == 0xFFFFFFFFu) { len = *(const uint64_t *)(frame + 4); body = frame + 12; }
+        if (*(const uint32_t *)body != 0) { __unw_add_dynamic_fde((uintptr_t)frame); n++; }   /* (an FDE: a CIE's id is 0) */
+        frame = body + len;
+    }
+    return n;
+}
+
+const RtModule *rt_ps4_load_nro_code(const RtModule *stub) {
+    char path[512], table[160];
+    snprintf(path, sizeof path, "%s/../nro/%s.so", rt_data_dir, stub->name);
+    snprintf(table, sizeof table, "rt_module_%s", stub->name);
+    int fd = open(path, O_RDONLY);
+    if (fd < 0) { fprintf(stderr, "[ro] cannot open %s: the NRO's code\n", path); return NULL; }
+    Ehdr eh;
+    Phdr ph[32];
+    if (!read_at(fd, &eh, sizeof eh, 0) || memcmp(eh.e_ident, "\x7f" "ELF", 4) || eh.e_phnum > 32 ||
+        !read_at(fd, ph, sizeof *ph * eh.e_phnum, (off_t)eh.e_phoff)) {
+        fprintf(stderr, "[ro] %s: not a library\n", path);
+        close(fd);
+        return NULL;
+    }
+    uint64_t span = 0;
+    const Phdr *dynamic = NULL, *unwind = NULL;
+    for (int i = 0; i < eh.e_phnum; i++) {
+        if (ph[i].p_type == PT_LOAD && ph[i].p_vaddr + ph[i].p_memsz > span) span = ph[i].p_vaddr + ph[i].p_memsz;
+        if (ph[i].p_type == PT_DYNAMIC) dynamic = &ph[i];
+        if (ph[i].p_type == PT_GNU_EH_FRAME) unwind = &ph[i];
+    }
+    /* written at `base` (the write mapping), run at `run`: relocations hold run addresses */
+    Ps4ExecMemory mem;
+    if (!rt_ps4_exec_alloc(span, &mem)) { fprintf(stderr, "[ro] no executable memory for %s (%llu MiB)\n", stub->name, (unsigned long long)(span >> 20)); close(fd); return NULL; }
+    uint8_t *base = mem.write, *run = mem.run;
+    for (int i = 0; i < eh.e_phnum; i++)
+        if (ph[i].p_type == PT_LOAD && ph[i].p_filesz && !read_at(fd, base + ph[i].p_vaddr, ph[i].p_filesz, (off_t)ph[i].p_offset)) {
+            fprintf(stderr, "[ro] %s: cannot read it\n", path);
+            close(fd);
+            return NULL;
+        }
+    close(fd);
+    if (!dynamic) { fprintf(stderr, "[ro] %s: no dynamic section\n", path); return NULL; }
+
+    const Sym *syms = NULL;
+    const char *strs = NULL;
+    const uint32_t *hash = NULL;
+    const Rela *rela = NULL, *plt = NULL;
+    uint64_t rela_size = 0, plt_size = 0, init = 0, init_array = 0, init_count = 0;
+    for (const Dyn *d = (const Dyn *)(base + dynamic->p_vaddr); d->d_tag != DT_NULL; d++) {
+        switch (d->d_tag) {
+        case DT_SYMTAB: syms = (const Sym *)(base + d->d_val); break;
+        case DT_STRTAB: strs = (const char *)(base + d->d_val); break;
+        case DT_HASH: hash = (const uint32_t *)(base + d->d_val); break;
+        case DT_RELA: rela = (const Rela *)(base + d->d_val); break;
+        case DT_RELASZ: rela_size = d->d_val; break;
+        case DT_JMPREL: plt = (const Rela *)(base + d->d_val); break;
+        case DT_PLTRELSZ: plt_size = d->d_val; break;
+        case DT_INIT: init = d->d_val; break;
+        case DT_INIT_ARRAY: init_array = d->d_val; break;
+        case DT_INIT_ARRAYSZ: init_count = d->d_val / 8; break;
+        }
+    }
+    if (!syms || !strs || !hash) { fprintf(stderr, "[ro] %s: no symbol table\n", path); return NULL; }
+
+    u32 missing = 0, bound = 0;
+    const Rela *lists[2] = {rela, plt};
+    uint64_t counts[2] = {rela_size / sizeof(Rela), plt_size / sizeof(Rela)};
+    for (int l = 0; l < 2; l++)
+        for (uint64_t i = 0; lists[l] && i < counts[l]; i++) {
+            const Rela *r = &lists[l][i];
+            uint32_t type = (uint32_t)r->r_info, index = (uint32_t)(r->r_info >> 32);
+            uint64_t *at = (uint64_t *)(base + r->r_offset);
+            if (type == R_NONE) continue;
+            if (type == R_RELATIVE) { *at = (uint64_t)(uintptr_t)run + (uint64_t)r->r_addend; continue; }
+            if (type != R_64 && type != R_GLOB_DAT && type != R_JUMP_SLOT) {
+                fprintf(stderr, "[ro] %s: relocation type %u not handled\n", stub->name, type);
+                return NULL;
+            }
+            const Sym *s = &syms[index];
+            const char *name = strs + s->st_name;
+            int found;
+            uint64_t value = (uint64_t)(uintptr_t)eboot_symbol(name, &found);
+            if (!found) {
+                if (s->st_shndx) value = (uint64_t)(uintptr_t)run + s->st_value;
+                else if ((s->st_info >> 4) == 2) value = 0;   /* (an undefined weak one) */
+                else { if (missing++ < 8) fprintf(stderr, "[ro] %s: undefined symbol %s\n", stub->name, name); continue; }
+            } else bound++;
+            *at = value + (type == R_64 ? (uint64_t)r->r_addend : 0);
+        }
+    if (missing) { fprintf(stderr, "[ro] %s: %u undefined symbols\n", stub->name, missing); return NULL; }
+
+    const RtModule *mod = NULL;
+    for (uint32_t i = 0, n = hash[1]; i < n && !mod; i++)   /* (the SysV hash table's nchain: the symbol count) */
+        if (syms[i].st_shndx && !strcmp(strs + syms[i].st_name, table)) mod = (const RtModule *)(run + syms[i].st_value);
+    if (!mod) { fprintf(stderr, "[ro] %s: no %s in it\n", path, table); return NULL; }
+    /* the run range, segment by segment: code read-execute, data read-write, the rest read-only (direct memory
+     * mapped twice; flexible memory is one read-write-execute mapping already) */
+    for (int i = 0; i < eh.e_phnum; i++)
+        if (ph[i].p_type == PT_LOAD && ph[i].p_memsz) {
+            int prot = 1 | (ph[i].p_flags & 2 ? 2 : 0) | (ph[i].p_flags & 1 ? 4 : 0);   /* (ELF: PF_X 1, PF_W 2, PF_R 4) */
+            if (!rt_ps4_exec_protect(&mem, ph[i].p_vaddr, ph[i].p_memsz, prot)) return NULL;
+        }
+    u32 fdes = unwind ? register_unwind(run, unwind, span) : 0;
+    if (init) ((void (*)(void))(void *)(run + init))();
+    for (uint64_t i = 0; i < init_count; i++) {
+        void (*fn)(void) = ((void (**)(void))(void *)(run + init_array))[i];
+        if (fn && (uintptr_t)fn != (uintptr_t)-1) fn();
+    }
+    fprintf(stderr, "[ro] %s's code: %llu MiB at %p (%s), %u symbols from the eboot, %u unwind entries\n", stub->name,
+            (unsigned long long)(span >> 20), (void *)run, rt_ps4_exec_name(&mem), bound, fdes);
+    return mod;
+}

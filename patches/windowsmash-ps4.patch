diff --git a/runtime/ps4/include/ps4_compat.h b/runtime/ps4/include/ps4_compat.h
new file mode 100644
index 0000000..267d2cd
--- /dev/null
+++ b/runtime/ps4/include/ps4_compat.h
@@ -0,0 +1,82 @@
+/* PS4 (the SSBU port): what the Linux platform layer (runtime/linux) takes from Linux and the PS4's
+ * C library (FreeBSD's, by way of OpenOrbis) spells differently or lacks. Included before
+ * everything else in every runtime file (tools/ps4/build_ps4.py: -include). */
+#pragma once
+#ifdef __ORBIS__
+#include <sys/types.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* A thread's id (Linux: the kernel's, from gettid): libkernel's for the calling thread. */
+int ps4_gettid(void) __asm__("scePthreadGetthreadid");
+static inline pid_t gettid(void) { return (pid_t)ps4_gettid(); }
+
+/* futimens' "leave this time as it is" (FreeBSD's values; the C library's headers lack them) */
+#ifndef UTIME_OMIT
+#define UTIME_NOW (-1L)
+#define UTIME_OMIT (-2L)
+#endif
+
+/* runtime/ps4/memory.c: a fault the guest's memory takes care of (a committed page mapped on its
+ * first touch, a write the protecting write watch notes): 1 when the access can be retried. */
+int rt_ps4_fault(void *address, int writing);
+/* The guest's memory: direct memory mapped so far, chunk mappings that failed (out of memory). */
+unsigned long long rt_ps4_mapped_bytes(void);
+unsigned long long rt_ps4_failed_maps(void);
+
+/* runtime/ps4/memory.c: memory that runs code (the NRO libraries: elfload.c). `run` is where it runs,
+ * `write` where it is written (the same memory; another address for direct memory mapped twice, whose run
+ * range rt_ps4_exec_protect maps segment by segment: prot 1 read, 2 write, 4 execute). */
+typedef struct Ps4ExecMemory { unsigned char *run, *write; int source; unsigned long long size; long long phys; } Ps4ExecMemory;
+int rt_ps4_exec_alloc(size_t size, Ps4ExecMemory *m);
+int rt_ps4_exec_protect(const Ps4ExecMemory *m, unsigned long long offset, unsigned long long size, int prot);
+const char *rt_ps4_exec_name(const Ps4ExecMemory *m);
+
+/* Relative paths: the runtime names its files from its working folder (dump/modules/..., save/,
+ * reports/, display.ini) and the PS4 resolves none of them, chdir or not (v00.04: "cannot open
+ * dump/modules/main.reloc.bin" with /data/SSBU the working folder). Each relative path is taken
+ * as /data/SSBU's (runtime/ps4/start.c); absolute ones go as they are. (A few buffers a thread,
+ * in turn: a call may take two paths.) */
+const char *rt_ps4_path(const char *path);
+
+#ifdef __cplusplus
+}
+#endif
+
+#ifndef __cplusplus   /* (the C files' calls: the system headers first, then the calls redirected) */
+#include <dirent.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#undef R_OK   /* (access()'s modes: unused here, and kernel.c's result codes have the names) */
+#undef W_OK
+#undef X_OK
+#define fopen(p, m) fopen(rt_ps4_path(p), m)
+#define open(p, ...) open(rt_ps4_path(p), __VA_ARGS__)
+#define stat(p, s) stat(rt_ps4_path(p), s)
+#define mkdir(p, m) mkdir(rt_ps4_path(p), m)
+#define rmdir(p) rmdir(rt_ps4_path(p))
+#define unlink(p) unlink(rt_ps4_path(p))
+#define remove(p) remove(rt_ps4_path(p))
+#define rename(a, b) rename(rt_ps4_path(a), rt_ps4_path(b))
+#define opendir(p) opendir(rt_ps4_path(p))
+
+/* Reads into guest memory (module images, the shared fonts, a socket's data into the guest's buffer): the
+ * kernel cannot fault the lazily mapped pages in, so they are mapped first (runtime/ps4/memory.c; for any
+ * other memory a lookup that finds nothing). */
+#include <sys/socket.h>
+void rt_ww_prepare_write(void *p, size_t n);
+static inline size_t rt_ps4_fread(void *b, size_t s, size_t n, FILE *f) { rt_ww_prepare_write(b, s * n); return fread(b, s, n, f); }
+static inline ssize_t rt_ps4_recv(int fd, void *b, size_t n, int fl) { rt_ww_prepare_write(b, n); return recv(fd, b, n, fl); }
+static inline ssize_t rt_ps4_recvfrom(int fd, void *b, size_t n, int fl, struct sockaddr *a, socklen_t *al) {
+    rt_ww_prepare_write(b, n);
+    return recvfrom(fd, b, n, fl, a, al);
+}
+#define fread(b, s, n, f) rt_ps4_fread(b, s, n, f)
+#define recv(fd, b, n, fl) rt_ps4_recv(fd, b, n, fl)
+#define recvfrom(fd, b, n, fl, a, al) rt_ps4_recvfrom(fd, b, n, fl, a, al)
+#endif
+#endif
diff --git a/runtime/ps4/memory.c b/runtime/ps4/memory.c
new file mode 100644
index 0000000..b55da92
--- /dev/null
+++ b/runtime/ps4/memory.c
@@ -0,0 +1,660 @@
+/* Memory for the PS4 build of the Windows API (runtime/linux/include/windows.h): VirtualAlloc and
+ * the rest, and the write watch - what runtime/linux/win32.c does on Linux and runtime/macos/
+ * memory.c on macOS, for a system with no demand-zero memory to speak of (the SMW port's design,
+ * its runtime/src/platform_ps4.cpp).
+ *
+ * The PS4's anonymous memory (flexible memory) is small - a few hundred MiB - and committed when
+ * mapped; the game's memory has to be direct memory (physical), of which an app has ~4.5 GiB. The
+ * runtime reserves tens of GiB and commits gigabytes it may never touch (svcSetHeapSize: the whole
+ * heap at once; 512 MiB and 64 MiB thread stacks). So a reservation is address space only
+ * (sceKernelReserveVirtualRange); committing marks its 4 KiB pages usable; the first access to a
+ * committed page faults, and the fault handler (host.c, rt_ps4_fault) maps the 64 KiB chunk
+ * holding it with direct memory, zeroed. Decommitting gives fully decommitted chunks back (to a
+ * free list) and zeroes the decommitted pages of the others. Direct memory is allocated in 32 MiB
+ * blocks (smaller pieces when it is fragmented) and handed out by chunk.
+ *
+ * Reservations with no address of their own (VirtualAlloc(NULL, ...): thread stacks, the
+ * runtime's copies of module code, the NROs' code) come from a host range of 104 GiB - every guest
+ * thread's stack reserves 256 MiB (16 GiB ran out in v00.07) - [0x4600000000, 0x6000000000): between
+ * RADV's GPU windows ([0x4000000000, 0x4500000000), the PS4
+ * winsys's) and the guest's lowest range (the alias area at 0x6000000000; host.h: the guest's go up
+ * to 0x7800000000 and beyond, its shared fonts there - v00.06's host range at 0x7800000000 took it).
+ *
+ * The write watch is page protection, as on macOS (16 KiB host pages, 4 KiB guest pages): a
+ * watched area's chunks are mapped read-only; the first write to a host page faults, and the
+ * handler marks every committed 4 KiB page of it written and makes it writable. GetWriteWatch
+ * reports 4 KiB pages; a reset clears them and makes their host pages read-only again. A system
+ * call cannot fault on our behalf (it fails with EFAULT): rt_ww_prepare_write maps and opens the
+ * pages first, and reads go through a host buffer (win32.c read_some) when they fail.
+ *
+ * Everything here runs under one spin lock, which the fault handler takes too: no mutex, no
+ * allocation, nothing that could fault inside it. */
+#include <errno.h>
+#include <sched.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+
+#include <windows.h>
+
+typedef uint8_t u8;
+typedef uint32_t u32;
+typedef uint64_t u64;
+
+/* libkernel, declared by hand (several OpenOrbis prototypes are wrong or take no parameters) */
+int32_t ps4_reserve_range(void **addr, size_t len, int32_t flags, size_t align) __asm__("sceKernelReserveVirtualRange");
+int32_t ps4_map_direct(void **addr, size_t len, int32_t prot, int32_t flags, off_t phys, size_t align) __asm__("sceKernelMapDirectMemory");
+int32_t ps4_allocate_direct(off_t start, off_t end, size_t len, size_t align, int32_t type, off_t *phys) __asm__("sceKernelAllocateDirectMemory");
+size_t ps4_direct_memory_size(void) __asm__("sceKernelGetDirectMemorySize");
+int32_t ps4_munmap(void *addr, size_t len) __asm__("sceKernelMunmap");
+int32_t ps4_mprotect(const void *addr, size_t len, int32_t prot) __asm__("sceKernelMprotect");
+
+#define GPAGE 0x1000ull     /* a guest page: what is committed */
+#define HPAGE 0x4000ull     /* a host page: what is protected */
+#define CHUNK 0x10000ull    /* what is mapped */
+#define BLOCK (32ull << 20) /* what is allocated */
+#define MAP_FIXED_PS4 0x10
+#define PROT_R 0x1
+#define PROT_RW 0x3
+#define WB_ONION 0
+
+#define HOST_BASE 0x4600000000ull
+#define HOST_END 0x6000000000ull
+#define MAX_AREAS 1024
+#define MAX_FREE (1u << 17)   /* freed chunks kept for reuse (8 GiB worth) */
+
+typedef struct Area {
+    u64 base, size;
+    int watch;
+    u8 *committed;   /* a bit a 4 KiB page */
+    u8 *dirty;       /* a bit a 4 KiB page (watched areas) */
+    u32 *phys;       /* a chunk's direct memory, offset / CHUNK + 1 while mapped (0: not mapped) */
+} Area;
+
+static Area areas[MAX_AREAS];   /* sorted by base */
+static int nareas;
+static volatile int lock_word;
+static u64 block_at, block_size, block_used;
+static u32 free_chunks[MAX_FREE];
+static u32 nfree;
+static u64 host_next = HOST_BASE;
+static struct { u64 base, size; } host_free[256];   /* released host ranges, for reuse */
+static int nhost_free;
+static volatile u64 mapped_bytes, failed_maps, faults;
+
+static void lock(void) { while (__atomic_exchange_n(&lock_word, 1, __ATOMIC_ACQUIRE)) sched_yield(); }
+static void unlock(void) { __atomic_store_n(&lock_word, 0, __ATOMIC_RELEASE); }
+
+static int bit(const u8 *map, u64 i) { return map[i >> 3] >> (i & 7) & 1; }
+static void set_bit(u8 *map, u64 i) { map[i >> 3] |= (u8)(1u << (i & 7)); }
+static void clear_bit(u8 *map, u64 i) { map[i >> 3] &= (u8)~(1u << (i & 7)); }
+static u64 round_down(u64 v, u64 to) { return v & ~(to - 1); }
+static u64 round_up(u64 v, u64 to) { return (v + to - 1) & ~(to - 1); }
+
+unsigned long long rt_ps4_mapped_bytes(void) { return mapped_bytes; }
+unsigned long long rt_ps4_failed_maps(void) { return failed_maps; }
+
+/* The area holding [lo, hi), or NULL. (Under the lock.) */
+static Area *area_of(u64 lo, u64 hi) {
+    int a = 0, b = nareas;
+    while (a < b) {
+        int m = (a + b) / 2;
+        if (areas[m].base + areas[m].size <= lo) a = m + 1; else b = m;
+    }
+    if (a < nareas && areas[a].base <= lo && hi <= areas[a].base + areas[a].size) return &areas[a];
+    return NULL;
+}
+
+/* ---- direct memory -------------------------------------------------------------------------- */
+#define NO_PHYS UINT32_MAX
+
+static u32 take_phys(void) {
+    if (nfree) return free_chunks[--nfree];
+    if (block_used == block_size) {
+        off_t phys = 0;
+        u64 size = BLOCK;
+        while (ps4_allocate_direct(0, (off_t)ps4_direct_memory_size(), size, CHUNK, WB_ONION, &phys) != 0)
+            if ((size /= 2) < CHUNK) return NO_PHYS;
+        block_at = (u64)phys;
+        block_size = size;
+        block_used = 0;
+    }
+    u64 at = block_at + block_used;
+    block_used += CHUNK;
+    return (u32)(at / CHUNK);
+}
+
+static void give_phys(u32 phys) {
+    if (nfree < MAX_FREE) free_chunks[nfree++] = phys;
+}
+
+static void reserve_back(u64 addr, u64 size) {
+    void *p = (void *)(uintptr_t)addr;
+    ps4_reserve_range(&p, size, MAP_FIXED_PS4, 0);
+}
+
+/* Maps chunk `ci` of `a` with zeroes: read-only in a watched area, else read-write. (Under the lock.) */
+static int map_chunk(Area *a, u64 ci) {
+    u32 phys = take_phys();
+    if (phys == NO_PHYS) { failed_maps++; return 0; }
+    u64 addr = a->base + ci * CHUNK;
+    ps4_munmap((void *)(uintptr_t)addr, CHUNK);   /* (our reservation there: mapping over it fails) */
+    void *at = (void *)(uintptr_t)addr;
+    if (ps4_map_direct(&at, CHUNK, PROT_RW, MAP_FIXED_PS4, (off_t)phys * (off_t)CHUNK, CHUNK) != 0 || at != (void *)(uintptr_t)addr) {
+        reserve_back(addr, CHUNK);
+        give_phys(phys);
+        failed_maps++;
+        return 0;
+    }
+    memset(at, 0, CHUNK);   /* (direct memory comes with whatever was there before) */
+    if (a->watch) {
+        /* host pages none of whose committed pages are written start read-only */
+        for (u64 h = 0; h < CHUNK; h += HPAGE) {
+            u64 first = (ci * CHUNK + h) / GPAGE, written = 0;
+            for (u64 g = 0; g < HPAGE / GPAGE; g++) written |= (u64)bit(a->dirty, first + g);
+            if (!written) ps4_mprotect((void *)(uintptr_t)(addr + h), HPAGE, PROT_R);
+        }
+    }
+    a->phys[ci] = phys + 1;
+    mapped_bytes += CHUNK;
+    return 1;
+}
+
+static void unmap_chunk(Area *a, u64 ci) {
+    u64 addr = a->base + ci * CHUNK;
+    ps4_munmap((void *)(uintptr_t)addr, CHUNK);
+    reserve_back(addr, CHUNK);
+    give_phys(a->phys[ci] - 1);
+    a->phys[ci] = 0;
+    mapped_bytes -= CHUNK;
+}
+
+/* A write to host page `h` (offset in `a`) of a watched area: its committed pages are written. */
+static void open_page(Area *a, u64 h) {
+    for (u64 g = h / GPAGE; g < (h + HPAGE) / GPAGE; g++)
+        if (bit(a->committed, g)) set_bit(a->dirty, g);
+    ps4_mprotect((void *)(uintptr_t)(a->base + h), HPAGE, PROT_RW);
+}
+
+/* ---- the fault handler's part --------------------------------------------------------------- */
+static __thread u64 last_fault;
+static __thread u32 repeats;
+
+int rt_ps4_fault(void *address, int writing) {
+    u64 addr = (u64)(uintptr_t)address;
+    lock();
+    Area *a = area_of(addr, addr + 1);
+    if (!a || !bit(a->committed, (addr - a->base) / GPAGE)) { unlock(); return 0; }
+    u64 off = addr - a->base, ci = off / CHUNK;
+    int ok = 0;
+    if (!a->phys[ci]) {
+        faults++;
+        ok = map_chunk(a, ci);   /* (a write to a watched one faults again, into the case below) */
+    } else if (a->watch && writing) {
+        open_page(a, round_down(off, HPAGE));
+        ok = 1;
+    } else {
+        /* mapped by another thread between the access and now: retried. The same address faulting
+         * again and again on a mapped page is a real protection fault. */
+        repeats = last_fault == addr ? repeats + 1 : 0;
+        last_fault = addr;
+        ok = repeats < 4;
+    }
+    unlock();
+    return ok;
+}
+
+/* ---- reservations --------------------------------------------------------------------------- */
+static Area *add_area(u64 base, u64 size, int watch) {
+    if (nareas == MAX_AREAS) { fprintf(stderr, "[mem] too many reservations\n"); return NULL; }
+    u64 pages = size / GPAGE, chunks = size / CHUNK;
+    u8 *committed = calloc(1, pages / 8 + 1), *dirty = watch ? calloc(1, pages / 8 + 1) : NULL;
+    u32 *phys = calloc(chunks + 1, sizeof *phys);
+    if (!committed || !phys || (watch && !dirty)) { free(committed); free(dirty); free(phys); return NULL; }
+    int i = nareas;
+    while (i > 0 && areas[i - 1].base > base) { areas[i] = areas[i - 1]; i--; }
+    areas[i] = (Area){base, size, watch, committed, dirty, phys};
+    nareas++;
+    return &areas[i];
+}
+
+/* The host range, reserved whole on first use: what is handed out of it is ours already. */
+static int host_reserved;
+
+static u64 host_range(u64 size) {
+    if (!host_reserved) {
+        void *p = (void *)(uintptr_t)HOST_BASE;
+        host_reserved = ps4_reserve_range(&p, HOST_END - HOST_BASE, MAP_FIXED_PS4, 0) == 0 && p == (void *)(uintptr_t)HOST_BASE ? 1 : -1;
+        if (host_reserved < 0) fprintf(stderr, "[mem] cannot reserve the host range [%#llx, %#llx)\n", HOST_BASE, HOST_END);
+    }
+    if (host_reserved < 0) return 0;
+    for (int i = 0; i < nhost_free; i++)
+        if (host_free[i].size >= size) {
+            u64 at = host_free[i].base;
+            host_free[i].base += size;
+            host_free[i].size -= size;
+            if (!host_free[i].size) host_free[i] = host_free[--nhost_free];
+            return at;
+        }
+    if (host_next + size > HOST_END) return 0;
+    u64 at = host_next;
+    host_next += size;
+    return at;
+}
+
+static void commit_pages(Area *a, u64 lo, u64 hi) {
+    for (u64 g = (lo - a->base) / GPAGE; g < (hi - a->base) / GPAGE; g++) {
+        if (bit(a->committed, g)) continue;
+        set_bit(a->committed, g);
+        if (a->watch) {
+            /* a page newly committed under a host page already writable is reported written: its
+             * writes would go unseen otherwise */
+            u64 ci = g * GPAGE / CHUNK;
+            if (a->phys[ci] && bit(a->dirty, round_down(g * GPAGE, HPAGE) / GPAGE)) set_bit(a->dirty, g);
+            else clear_bit(a->dirty, g);
+        }
+    }
+}
+
+LPVOID VirtualAlloc(LPVOID address, SIZE_T size, DWORD type, DWORD protect) {
+    (void)protect;   /* (read-write: nothing here asks otherwise of committed memory) */
+    if (!size) { SetLastError(ERROR_INVALID_PARAMETER); return NULL; }
+    u64 lo = round_down((u64)(uintptr_t)address, GPAGE), hi = round_up((u64)(uintptr_t)address + size, GPAGE);
+    lock();
+    if ((type & MEM_RESERVE) || !address) {
+        u64 bytes = round_up(hi - lo, CHUNK);
+        if (!address) lo = host_range(bytes);
+        else {
+            lo = round_down(lo, CHUNK);
+            bytes = round_up(hi - lo, CHUNK);
+            void *p = (void *)(uintptr_t)lo;
+            if (area_of(lo, lo + 1) || ps4_reserve_range(&p, bytes, MAP_FIXED_PS4, 0) != 0 || p != (void *)(uintptr_t)lo) lo = 0;
+        }
+        Area *a = lo ? add_area(lo, bytes, (type & MEM_WRITE_WATCH) != 0) : NULL;
+        if (!a) { unlock(); SetLastError(ERROR_INVALID_ADDRESS); return NULL; }
+        if (type & MEM_COMMIT) commit_pages(a, lo, lo + round_up(size, GPAGE));
+        unlock();
+        return (void *)(uintptr_t)lo;
+    }
+    Area *a = area_of(lo, hi);
+    if (!a || !(type & MEM_COMMIT)) { unlock(); SetLastError(a ? ERROR_INVALID_PARAMETER : ERROR_INVALID_ADDRESS); return NULL; }
+    commit_pages(a, lo, hi);
+    unlock();
+    return (void *)(uintptr_t)lo;
+}
+
+/* Decommits [lo, hi) of `a`: chunks left with nothing committed go back, the rest have the pages
+ * zeroed (as Windows reads a recommitted page as zeros). (Under the lock.) */
+static void decommit(Area *a, u64 lo, u64 hi) {
+    for (u64 g = (lo - a->base) / GPAGE; g < (hi - a->base) / GPAGE; g++) {
+        clear_bit(a->committed, g);
+        if (a->watch) clear_bit(a->dirty, g);
+    }
+    for (u64 ci = (lo - a->base) / CHUNK; ci * CHUNK < hi - a->base; ci++) {
+        if (!a->phys[ci]) continue;
+        int any = 0;
+        for (u64 g = ci * CHUNK / GPAGE; g < (ci + 1) * CHUNK / GPAGE && !any; g++) any = bit(a->committed, g);
+        if (!any) { unmap_chunk(a, ci); continue; }
+        u64 c = a->base + ci * CHUNK, from = lo > c ? lo : c, to = hi < c + CHUNK ? hi : c + CHUNK;
+        ps4_mprotect((void *)(uintptr_t)c, CHUNK, PROT_RW);
+        memset((void *)(uintptr_t)from, 0, to - from);
+        if (a->watch)   /* (back to read-only where nothing committed is written) */
+            for (u64 h = 0; h < CHUNK; h += HPAGE) {
+                u64 first = (c - a->base + h) / GPAGE, written = 0;
+                for (u64 g = 0; g < HPAGE / GPAGE; g++) written |= (u64)bit(a->dirty, first + g);
+                if (!written) ps4_mprotect((void *)(uintptr_t)(c + h), HPAGE, PROT_R);
+            }
+    }
+}
+
+BOOL VirtualFree(LPVOID address, SIZE_T size, DWORD type) {
+    u64 lo = round_down((u64)(uintptr_t)address, GPAGE);
+    lock();
+    if (type & MEM_RELEASE) {
+        for (int i = 0; i < nareas; i++)
+            if (areas[i].base == lo) {
+                Area a = areas[i];
+                for (u64 ci = 0; ci < a.size / CHUNK; ci++) if (a.phys[ci]) unmap_chunk(&a, ci);
+                if (a.base >= HOST_BASE && a.base < HOST_END) {
+                    /* (the host range stays reserved: ours, for reuse) */
+                    if (nhost_free < 256) { host_free[nhost_free].base = a.base; host_free[nhost_free].size = a.size; nhost_free++; }
+                } else ps4_munmap((void *)(uintptr_t)a.base, a.size);
+                free(a.committed);
+                free(a.dirty);
+                free(a.phys);
+                memmove(&areas[i], &areas[i + 1], sizeof *areas * (size_t)(nareas - i - 1));
+                nareas--;
+                unlock();
+                return TRUE;
+            }
+        unlock();
+        SetLastError(ERROR_INVALID_ADDRESS);
+        return FALSE;
+    }
+    if (type & MEM_DECOMMIT) {
+        u64 hi = round_up((u64)(uintptr_t)address + size, GPAGE);
+        Area *a = area_of(lo, hi);
+        if (a) decommit(a, lo, hi);
+        unlock();
+        return a ? TRUE : FALSE;
+    }
+    unlock();
+    SetLastError(ERROR_INVALID_PARAMETER);
+    return FALSE;
+}
+
+static int ps4_prot(DWORD protect) {
+    switch (protect & 0xFF) {
+    case PAGE_NOACCESS: return 0;
+    case PAGE_READONLY: case PAGE_EXECUTE: case PAGE_EXECUTE_READ: return PROT_R;
+    default: return PROT_RW;
+    }
+}
+
+BOOL VirtualProtect(LPVOID address, SIZE_T size, DWORD protect, PDWORD old) {
+    if (old) *old = PAGE_READWRITE;
+    u64 lo = round_down((u64)(uintptr_t)address, HPAGE), hi = round_up((u64)(uintptr_t)address + size, HPAGE);
+    lock();
+    Area *a = area_of(lo, hi);
+    if (!a) {
+        unlock();
+        return mprotect((void *)(uintptr_t)lo, hi - lo, ps4_prot(protect)) == 0;
+    }
+    for (u64 ci = (lo - a->base) / CHUNK; ci * CHUNK < hi - a->base; ci++)
+        if (!a->phys[ci] && !map_chunk(a, ci)) { unlock(); SetLastError(ERROR_NOT_ENOUGH_MEMORY); return FALSE; }
+    ps4_mprotect((void *)(uintptr_t)lo, hi - lo, ps4_prot(protect));
+    unlock();
+    return TRUE;
+}
+
+/* The run of pages from the address with the same state: committed or reserved in an area, or
+ * the free gap up to the next one. */
+SIZE_T VirtualQuery(LPCVOID address, MEMORY_BASIC_INFORMATION *info, SIZE_T length) {
+    if (length < sizeof *info) return 0;
+    u64 at = round_down((u64)(uintptr_t)address, GPAGE);
+    memset(info, 0, sizeof *info);
+    lock();
+    Area *a = area_of(at, at + 1);
+    if (!a) {
+        u64 next = ~0ull;
+        for (int i = 0; i < nareas; i++) if (areas[i].base > at && areas[i].base < next) next = areas[i].base;
+        unlock();
+        if (next == ~0ull) return 0;
+        info->BaseAddress = (void *)(uintptr_t)at;
+        info->RegionSize = next - at;
+        info->State = MEM_FREE;
+        info->Protect = PAGE_NOACCESS;
+        return sizeof *info;
+    }
+    u64 g = (at - a->base) / GPAGE, end = a->size / GPAGE;
+    int state = bit(a->committed, g);
+    u64 e = g + 1;
+    while (e < end) {
+        if (!(e & 7) && e + 8 <= end && a->committed[e >> 3] == (state ? 0xFF : 0)) { e += 8; continue; }
+        if (bit(a->committed, e) != state) break;
+        e++;
+    }
+    info->BaseAddress = (void *)(uintptr_t)at;
+    info->AllocationBase = (void *)(uintptr_t)a->base;
+    info->RegionSize = (e - g) * GPAGE;
+    info->State = state ? MEM_COMMIT : MEM_RESERVE;
+    info->Protect = state ? PAGE_READWRITE : PAGE_NOACCESS;
+    info->Type = MEM_PRIVATE;
+    unlock();
+    return sizeof *info;
+}
+
+/* ---- the write watch ------------------------------------------------------------------------ */
+const char *rt_ww_mode(void) { return "page protection (direct memory mapped on first touch)"; }
+
+int rt_ww_fault(void *address) { return rt_ps4_fault(address, 1); }
+
+/* Before a system call writes [p, p + n): its committed pages mapped, and written (opened) where
+ * watched. */
+void rt_ww_prepare_write(void *p, size_t n) {
+    if (!n) return;
+    u64 lo = (u64)(uintptr_t)p, hi = lo + n;
+    lock();
+    for (u64 at = round_down(lo, GPAGE); at < hi;) {
+        Area *a = area_of(at, at + 1);
+        if (!a) { at += GPAGE; continue; }
+        u64 end = hi < a->base + a->size ? hi : a->base + a->size;
+        for (u64 ci = (at - a->base) / CHUNK; a->base + ci * CHUNK < end; ci++) {
+            u64 c = a->base + ci * CHUNK;
+            int any = 0;
+            for (u64 g = ci * CHUNK / GPAGE; g < (ci + 1) * CHUNK / GPAGE && !any; g++) any = bit(a->committed, g);
+            if (!any || (!a->phys[ci] && !map_chunk(a, ci))) continue;
+            if (a->watch)
+                for (u64 h = c > round_down(at, HPAGE) ? c : round_down(at, HPAGE); h < end && h < c + CHUNK; h += HPAGE)
+                    open_page(a, h - a->base);
+        }
+        at = end;
+    }
+    unlock();
+}
+
+/* Whether stores to all of [p, p + n) can go through (committed memory of ours): else an EFAULT
+ * is real. */
+int rt_ww_storable(const void *p, size_t n) {
+    u64 lo = round_down((u64)(uintptr_t)p, GPAGE), hi = round_up((u64)(uintptr_t)p + n, GPAGE);
+    lock();
+    Area *a = area_of(lo, hi);
+    int ok = a != NULL;
+    for (u64 g = a ? (lo - a->base) / GPAGE : 0; ok && g < (hi - (a ? a->base : 0)) / GPAGE; g++) ok = bit(a->committed, g);
+    unlock();
+    return ok;
+}
+
+UINT GetWriteWatch(DWORD flags, PVOID base, SIZE_T size, PVOID *addresses, ULONG_PTR *count, ULONG *granularity) {
+    u64 lo = round_down((u64)(uintptr_t)base, GPAGE), hi = round_up((u64)(uintptr_t)base + size, GPAGE);
+    if (granularity) *granularity = (ULONG)GPAGE;
+    lock();
+    Area *a = area_of(lo, hi);
+    if (!a || !a->watch || !count) { unlock(); SetLastError(ERROR_INVALID_PARAMETER); return 1; }
+    ULONG_PTR cap = *count, n = 0;
+    u64 first = (lo - a->base) / GPAGE, last = (hi - a->base) / GPAGE, run = ~0ull;
+    for (u64 g = first; g < last && n < cap;) {
+        if (!(g & 7) && g + 8 <= last && !a->dirty[g >> 3]) { g += 8; continue; }
+        if (bit(a->dirty, g)) {
+            addresses[n++] = (void *)(uintptr_t)(a->base + g * GPAGE);
+            if (flags & WRITE_WATCH_FLAG_RESET) {
+                clear_bit(a->dirty, g);
+                u64 h = round_down(g * GPAGE, HPAGE);
+                if (h != run && a->phys[h / CHUNK]) {   /* (each host page made read-only once) */
+                    ps4_mprotect((void *)(uintptr_t)(a->base + h), HPAGE, PROT_R);
+                    run = h;
+                }
+            }
+        }
+        g++;
+    }
+    unlock();
+    *count = n;
+    return 0;
+}
+
+UINT ResetWriteWatch(LPVOID base, SIZE_T size) {
+    u64 lo = round_down((u64)(uintptr_t)base, GPAGE), hi = round_up((u64)(uintptr_t)base + size, GPAGE);
+    lock();
+    Area *a = area_of(lo, hi);
+    if (!a || !a->watch) { unlock(); return 1; }
+    for (u64 h = round_down(lo - a->base, HPAGE); h < hi - a->base; h += HPAGE) {
+        int written = 0;
+        for (u64 g = h / GPAGE; g < (h + HPAGE) / GPAGE; g++) {
+            if (g * GPAGE >= lo - a->base && g * GPAGE < hi - a->base && bit(a->dirty, g)) { clear_bit(a->dirty, g); written = 1; }
+        }
+        if (!written) continue;
+        int still = 0;   /* (pages of the host page outside the range keep it writable) */
+        for (u64 g = h / GPAGE; g < (h + HPAGE) / GPAGE; g++) still |= bit(a->dirty, g);
+        if (!still && a->phys[h / CHUNK]) ps4_mprotect((void *)(uintptr_t)(a->base + h), HPAGE, PROT_R);
+    }
+    unlock();
+    return 0;
+}
+
+/* ---- executable memory (the NRO libraries' code: runtime/ps4/elfload.c) ---------------------- */
+/* The eboot's code is loaded into flexible memory, ~450 MiB in all: the game's 98 NRO modules (~1 GB of
+ * code) cannot be in it; a match needs a few of them. They are loaded as the game asks, into memory that
+ * runs code. Where that may come from depends on the console and its jailbreak (Crema's recompiler tries
+ * the same places), so each source is tried once, when first needed, with a one-instruction function (ret)
+ * run from it - Crema saw a firmware map memory executable and then fault on it - and the first that runs
+ * code serves, the next ones when it is full:
+ *   1. direct memory, mapped twice: written through a read-write mapping, run from another one of the same
+ *      pages mapped per segment (code read-execute, data read-write, constants read-only). Never writable
+ *      and executable at once: v00.05's console refused direct memory mapped read-write-execute.
+ *   2. system flexible memory, read-write-execute (Crema's first choice; shared with the kernel's objects
+ *      and the port's heap: SMW saw mutexes fail when the heap took 512 MiB of it)
+ *   3. regular flexible memory, read-write-execute (~200 MiB left beside the eboot; nothing else here takes
+ *      it: the graphics are RADV's, on direct memory)
+ * Never given back. */
+#include <setjmp.h>
+#include <signal.h>
+
+#define PROT_RX 0x5
+#define PROT_RWX 0x7
+int32_t ps4_map_system_flexible(void **addr, size_t len, int32_t prot, int32_t flags, const char *name) __asm__("sceKernelMapNamedSystemFlexibleMemory");
+int32_t ps4_map_flexible(void **addr, size_t len, int32_t prot, int32_t flags, const char *name) __asm__("sceKernelMapNamedFlexibleMemory");
+int32_t ps4_release_direct(off_t start, size_t len) __asm__("sceKernelReleaseDirectMemory");
+int32_t ps4_available_flexible(size_t *size) __asm__("sceKernelAvailableFlexibleMemorySize");
+
+enum { EXEC_DIRECT_TWICE, EXEC_SYSTEM, EXEC_REGULAR, EXEC_SOURCES };
+static const char *const exec_names[EXEC_SOURCES] = {"direct memory, mapped twice", "system flexible memory", "regular flexible memory"};
+static int exec_state[EXEC_SOURCES];   /* 0 untried, 1 runs code, -1 does not (or cannot be mapped so) */
+static u64 exec_bytes[EXEC_SOURCES];
+static sigjmp_buf probe_jump;
+static volatile int probing;
+
+static void probe_fault(int sig, siginfo_t *si, void *uc) {
+    (void)sig; (void)si; (void)uc;
+    if (probing) siglongjmp(probe_jump, 1);
+}
+
+/* Whether `run` (where `write` is written: the same memory) runs code. */
+static int runs_code(u8 *write, u8 *run) {
+    struct sigaction sa, old_segv, old_bus;
+    memset(&sa, 0, sizeof sa);
+    sa.sa_sigaction = probe_fault;
+    sa.sa_flags = SA_SIGINFO | SA_ONSTACK;
+    sigemptyset(&sa.sa_mask);
+    sigaction(SIGSEGV, &sa, &old_segv);
+    sigaction(SIGBUS, &sa, &old_bus);
+    write[0] = 0xC3;   /* ret */
+    int ok = 0;
+    probing = 1;
+    if (!sigsetjmp(probe_jump, 1)) {
+        ((void (*)(void))(void *)run)();
+        ok = 1;
+    }
+    probing = 0;
+    sigaction(SIGSEGV, &old_segv, NULL);
+    sigaction(SIGBUS, &old_bus, NULL);
+    return ok;
+}
+
+static u64 take_host_range(u64 bytes) {
+    lock();
+    u64 at = host_range(bytes);
+    unlock();
+    return at;
+}
+
+/* One mapping of `bytes` from `source` at `*m`: the run address, the write address (the same but for
+ * EXEC_DIRECT_TWICE, whose run range is only reserved here: rt_ps4_exec_protect maps it). 0 if not possible. */
+static int exec_map(int source, u64 bytes, Ps4ExecMemory *m) {
+    memset(m, 0, sizeof *m);
+    m->source = source;
+    m->size = bytes;
+    if (source == EXEC_DIRECT_TWICE) {
+        off_t phys = 0;
+        if (ps4_allocate_direct(0, (off_t)ps4_direct_memory_size(), bytes, CHUNK, WB_ONION, &phys) != 0) return 0;
+        u64 w = take_host_range(bytes), r = take_host_range(bytes);
+        if (!w || !r) { ps4_release_direct(phys, bytes); return 0; }
+        ps4_munmap((void *)(uintptr_t)w, bytes);
+        void *p = (void *)(uintptr_t)w;
+        if (ps4_map_direct(&p, bytes, PROT_RW, MAP_FIXED_PS4, phys, CHUNK) != 0 || p != (void *)(uintptr_t)w) {
+            reserve_back(w, bytes);
+            ps4_release_direct(phys, bytes);
+            return 0;
+        }
+        m->write = (u8 *)(uintptr_t)w;
+        m->run = (u8 *)(uintptr_t)r;
+        m->phys = phys;
+        return 1;
+    }
+    u64 at = take_host_range(bytes);
+    if (!at) return 0;
+    ps4_munmap((void *)(uintptr_t)at, bytes);
+    void *p = (void *)(uintptr_t)at;
+    int32_t r = source == EXEC_SYSTEM ? ps4_map_system_flexible(&p, bytes, PROT_RWX, MAP_FIXED_PS4, "ssbu nro code")
+                                      : ps4_map_flexible(&p, bytes, PROT_RWX, MAP_FIXED_PS4, "ssbu nro code");
+    if (r != 0 || p != (void *)(uintptr_t)at) { reserve_back(at, bytes); return 0; }
+    m->write = m->run = (u8 *)(uintptr_t)at;
+    return 1;
+}
+
+/* The run range of an EXEC_DIRECT_TWICE mapping: [offset, offset + size) of it mapped with `prot` (1 read, 2 write,
+ * 4 execute) - its pages of the same memory as the write mapping's. Nothing to do for the others. */
+int rt_ps4_exec_protect(const Ps4ExecMemory *m, unsigned long long offset, unsigned long long size, int prot) {
+    if (m->source != EXEC_DIRECT_TWICE) return 1;
+    u64 lo = round_down(offset, HPAGE), hi = round_up(offset + size, HPAGE);
+    void *at = m->run + lo;
+    ps4_munmap(at, hi - lo);   /* (its reservation) */
+    int32_t pr = (prot & 4) ? PROT_RX : (prot & 2) ? PROT_RW : PROT_R;
+    if (ps4_map_direct(&at, hi - lo, pr, MAP_FIXED_PS4, m->phys + (off_t)lo, HPAGE) != 0 || at != m->run + lo) {
+        fprintf(stderr, "[mem] cannot map code at %p (+%#llx, %llu KiB, prot %d)\n", (void *)m->run, (unsigned long long)lo,
+                (unsigned long long)((hi - lo) >> 10), pr);
+        return 0;
+    }
+    return 1;
+}
+
+static void probe(int source) {
+    Ps4ExecMemory m;
+    if (!exec_map(source, CHUNK, &m)) {
+        exec_state[source] = -1;
+        fprintf(stderr, "[mem] executable memory: %s cannot be mapped so\n", exec_names[source]);
+        return;
+    }
+    int ok = rt_ps4_exec_protect(&m, 0, CHUNK, 5) && runs_code(m.write, m.run);
+    exec_state[source] = ok ? 1 : -1;
+    fprintf(stderr, "[mem] executable memory: %s %s\n", exec_names[source], ok ? "runs code" : "does NOT run code");
+    /* (the probe's chunk is kept: what was mapped once is not worth the bookkeeping to take back) */
+}
+
+/* `size` bytes for code, zeroed: from the first source that runs code and has room. 0 if none. */
+int rt_ps4_exec_alloc(size_t size, Ps4ExecMemory *m) {
+    u64 bytes = round_up(size, CHUNK);
+    for (int s = 0; s < EXEC_SOURCES; s++) {
+        if (!exec_state[s]) probe(s);
+        if (exec_state[s] < 0) continue;
+        if (!exec_map(s, bytes, m)) {
+            size_t flexible = 0;
+            ps4_available_flexible(&flexible);
+            fprintf(stderr, "[mem] %s: no room for %llu MiB of code (%llu MiB taken; regular flexible memory free %zu MiB)\n",
+                    exec_names[s], (unsigned long long)(bytes >> 20), (unsigned long long)(exec_bytes[s] >> 20), flexible >> 20);
+            continue;
+        }
+        memset(m->write, 0, bytes);
+        exec_bytes[s] += bytes;
+        return 1;
+    }
+    return 0;
+}
+
+const char *rt_ps4_exec_name(const Ps4ExecMemory *m) { return exec_names[m->source]; }
+
+/* ---- thread and fiber stacks ---------------------------------------------------------------- */
+/* A stack of `size` from the host range: all committed but its lowest chunk (the guard: an
+ * overflow faults), its top `eager` bytes mapped now (system calls with buffers on the stack
+ * cannot fault them in). The reservation's base, for VirtualFree(MEM_RELEASE); NULL if none. */
+void *rt_ps4_stack(size_t size, size_t eager) {
+    size = (size_t)round_up(size < (1u << 20) ? (1u << 20) : size, CHUNK) + CHUNK;
+    u8 *base = VirtualAlloc(NULL, size, MEM_RESERVE, PAGE_READWRITE);
+    if (!base) return NULL;
+    VirtualAlloc(base + CHUNK, size - CHUNK, MEM_COMMIT, PAGE_READWRITE);
+    if (eager > size - CHUNK) eager = size - CHUNK;
+    rt_ww_prepare_write(base + size - eager, eager);
+    return base;
+}
diff --git a/runtime/ps4/pad.c b/runtime/ps4/pad.c
new file mode 100644
index 0000000..0af8d3c
--- /dev/null
+++ b/runtime/ps4/pad.c
@@ -0,0 +1,95 @@
+/* The PS4's controllers for hle_pad.c: DualShock 4s through libScePad, behind the XInput backend's
+ * two calls (XInputGetState, XInputSetState). Pad i is the i-th signed-in user's (up to 4);
+ * users who sign in later are found when their pad is next asked for (every half second while
+ * missing, hle_pad.c). The DualShock 4's buttons have XInput's positions - Cross the bottom one,
+ * Circle the right, Square the left, Triangle the top; Options is Start, the touch pad click Back -
+ * and L2/R2 are its analog triggers. */
+#include <stdint.h>
+#include <string.h>
+
+#include <orbis/Pad.h>
+#include <orbis/UserService.h>
+
+#include <windows.h>
+
+#include "../debug_profile.h"
+
+typedef struct { WORD buttons; BYTE lt, rt; SHORT lx, ly, rx, ry; } XPad;   /* (hle_pad.c's) */
+typedef struct { DWORD packet; XPad pad; } XState;
+typedef struct { WORD left, right; } XVibration;
+
+#define PADS 4
+static struct { int32_t user; int handle; } pads[PADS] = {{-1, -1}, {-1, -1}, {-1, -1}, {-1, -1}};
+static SRWLOCK pads_lock = SRWLOCK_INIT;
+static int started;
+
+int ps4_pad_start(void) {
+    if (started) return started > 0;
+    sceUserServiceInitialize(NULL);
+    started = scePadInit() == 0 ? 1 : -1;
+    return started > 0;
+}
+
+/* The pad of the i-th signed-in user, opened on first use. */
+static int handle_of(DWORD i) {
+    if (i >= PADS) return -1;
+    AcquireSRWLockExclusive(&pads_lock);
+    OrbisUserServiceLoginUserIdList list;
+    memset(&list, 0, sizeof list);
+    int32_t user = -1;
+    if (sceUserServiceGetLoginUserIdList(&list) == 0) {
+        int n = 0;
+        for (int k = 0; k < ORBIS_USER_SERVICE_MAX_LOGIN_USERS; k++)
+            if (list.userId[k] != -1 && n++ == (int)i) { user = list.userId[k]; break; }
+    }
+    if (pads[i].user != user && pads[i].handle >= 0) { scePadClose(pads[i].handle); pads[i].handle = -1; }
+    pads[i].user = user;
+    if (user != -1 && pads[i].handle < 0) pads[i].handle = scePadOpen(user, ORBIS_PAD_PORT_TYPE_STANDARD, 0, NULL);
+    int h = pads[i].handle;
+    ReleaseSRWLockExclusive(&pads_lock);
+    return h;
+}
+
+/* 0..255 (128 the centre) to -32768..32767; `flip` turns it over (XInput's +y is up, the DualShock's down) */
+static SHORT axis(uint8_t v, int flip) {
+    int a = ((int)v - 128) * 258;
+    if (flip) a = -a;
+    return (SHORT)(a < -32768 ? -32768 : a > 32767 ? 32767 : a);
+}
+
+/* 0 with the pad's state, else its absence (ERROR_DEVICE_NOT_CONNECTED). */
+DWORD ps4_pad_get_state(DWORD i, XState *out) {
+    int h = handle_of(i);
+    OrbisPadData d;
+    memset(&d, 0, sizeof d);
+    if (h < 0 || scePadReadState(h, &d) != 0 || !d.connected) return 1167;
+    static const struct { uint32_t ds4; WORD x; } MAP[] = {
+        {ORBIS_PAD_BUTTON_CROSS, 0x1000}, {ORBIS_PAD_BUTTON_CIRCLE, 0x2000}, {ORBIS_PAD_BUTTON_SQUARE, 0x4000},
+        {ORBIS_PAD_BUTTON_TRIANGLE, 0x8000}, {ORBIS_PAD_BUTTON_TOUCH_PAD, 0x0020}, {ORBIS_PAD_BUTTON_OPTIONS, 0x0010},
+        {ORBIS_PAD_BUTTON_L3, 0x0040}, {ORBIS_PAD_BUTTON_R3, 0x0080}, {ORBIS_PAD_BUTTON_L1, 0x0100},
+        {ORBIS_PAD_BUTTON_R1, 0x0200}, {ORBIS_PAD_BUTTON_UP, 0x0001}, {ORBIS_PAD_BUTTON_DOWN, 0x0002},
+        {ORBIS_PAD_BUTTON_LEFT, 0x0004}, {ORBIS_PAD_BUTTON_RIGHT, 0x0008},
+    };
+    memset(out, 0, sizeof *out);
+    out->packet = d.timestamp;
+    for (unsigned k = 0; k < sizeof MAP / sizeof *MAP; k++)
+        if (d.buttons & MAP[k].ds4) out->pad.buttons |= MAP[k].x;
+    out->pad.lt = d.analogButtons.l2;
+    out->pad.rt = d.analogButtons.r2;
+    out->pad.lx = axis(d.leftStick.x, 0);
+    out->pad.ly = axis(d.leftStick.y, 1);
+    out->pad.rx = axis(d.rightStick.x, 0);
+    out->pad.ry = axis(d.rightStick.y, 1);
+    /* L3+R3 pressed together: a 10 s profile (debug_profile.h; F6 on a PC) */
+    static int combo_held;
+    int combo = (d.buttons & (ORBIS_PAD_BUTTON_L3 | ORBIS_PAD_BUTTON_R3)) == (ORBIS_PAD_BUTTON_L3 | ORBIS_PAD_BUTTON_R3);
+    if (combo && !combo_held) profile_start(10.0);
+    combo_held = combo;
+    return 0;
+}
+
+DWORD ps4_pad_set_state(DWORD i, XVibration *v) {
+    if (i >= PADS || pads[i].handle < 0) return 1167;
+    OrbisPadVibeParam vibe = {(uint8_t)(v->left >> 8), (uint8_t)(v->right >> 8)};   /* (large motor, small motor) */
+    return scePadSetVibration(pads[i].handle, &vibe) == 0 ? 0 : 1167;
+}
diff --git a/runtime/ps4/platform.c b/runtime/ps4/platform.c
new file mode 100644
index 0000000..95981a3
--- /dev/null
+++ b/runtime/ps4/platform.c
@@ -0,0 +1,91 @@
+/* What the PS4 build of the Windows API (runtime/linux/win32.c) needs from the system that Linux
+ * has and the PS4 lacks: waiting on an address (Linux's futex) and walking the stack (glibc's
+ * backtrace).
+ *
+ * Waiting on an address: the PS4's kernel has no futex for applications, so waiters sleep on one
+ * of 256 condition variables picked by the address. A wake wakes every waiter on its variable -
+ * other addresses' too, which then find their value unchanged and wait again (callers loop, as
+ * with a futex's spurious wakeups). The value is checked under the variable's lock, which the
+ * waker takes before it wakes, so a change between the check and the sleep is never missed. */
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <time.h>
+#include <unwind.h>
+
+#include <windows.h>
+
+typedef uint64_t u64;
+
+#define BUCKETS 256
+static struct Bucket {
+    pthread_mutex_t m;
+    pthread_cond_t cv;
+} buckets[BUCKETS];
+
+__attribute__((constructor)) static void futex_init(void) {
+    pthread_condattr_t a;
+    pthread_condattr_init(&a);
+    pthread_condattr_setclock(&a, CLOCK_MONOTONIC);
+    for (int i = 0; i < BUCKETS; i++) {
+        pthread_mutex_init(&buckets[i].m, NULL);
+        pthread_cond_init(&buckets[i].cv, &a);
+    }
+    pthread_condattr_destroy(&a);
+}
+
+static struct Bucket *bucket_of(volatile int *addr) {
+    uintptr_t a = (uintptr_t)addr >> 2;
+    return &buckets[(a ^ (a >> 8) ^ (a >> 16)) % BUCKETS];
+}
+
+const char *rt_futex_mode(void) { return "condition variables by address"; }
+
+/* 1 woken (or not holding `value`), 0 timed out */
+int rt_futex_wait(volatile int *addr, int value, DWORD ms) {
+    struct Bucket *b = bucket_of(addr);
+    struct timespec until;
+    if (ms != INFINITE) {
+        clock_gettime(CLOCK_MONOTONIC, &until);
+        until.tv_sec += ms / 1000;
+        until.tv_nsec += (long)(ms % 1000) * 1000000L;
+        if (until.tv_nsec >= 1000000000L) { until.tv_sec++; until.tv_nsec -= 1000000000L; }
+    }
+    int woken = 1;
+    pthread_mutex_lock(&b->m);
+    if (__atomic_load_n(addr, __ATOMIC_SEQ_CST) == value) {
+        if (ms == INFINITE) pthread_cond_wait(&b->cv, &b->m);
+        else if (ms == 0 || pthread_cond_timedwait(&b->cv, &b->m, &until) == ETIMEDOUT) woken = 0;
+    }
+    pthread_mutex_unlock(&b->m);
+    return woken;
+}
+
+void rt_futex_wake(volatile int *addr, int all) {
+    (void)all;   /* (every waiter on the variable: see the top of the file) */
+    struct Bucket *b = bucket_of(addr);
+    pthread_mutex_lock(&b->m);
+    pthread_cond_broadcast(&b->cv);
+    pthread_mutex_unlock(&b->m);
+}
+
+/* ---- backtraces --------------------------------------------------------------------------- */
+struct Walk {
+    void **frames;
+    int max, n;
+};
+
+static _Unwind_Reason_Code walk_one(struct _Unwind_Context *ctx, void *arg) {
+    struct Walk *w = arg;
+    if (w->n >= w->max) return _URC_END_OF_STACK;
+    uintptr_t pc = _Unwind_GetIP(ctx);
+    if (!pc) return _URC_END_OF_STACK;
+    w->frames[w->n++] = (void *)pc;
+    return _URC_NO_REASON;
+}
+
+int backtrace(void **frames, int max) {
+    struct Walk w = {frames, max, 0};
+    _Unwind_Backtrace(walk_one, &w);
+    return w.n;
+}
diff --git a/runtime/ps4/profile.c b/runtime/ps4/profile.c
new file mode 100644
index 0000000..68fb57e
--- /dev/null
+++ b/runtime/ps4/profile.c
@@ -0,0 +1,62 @@
+/* The sampling profiler on the PS4: the port's (port/ps4_profile.cpp in the SSBU repo), which samples
+ * the game's own threads for a few seconds and writes /data/SSBU/profiles/profile_<n>.txt (its
+ * addresses named on the PC: scripts/profile.py). Started by F6's callers (L3+R3: pad.c) and, here,
+ * when the frame rate drops: under 30 frames a second for two seconds in a row starts one (one a
+ * half minute at most, six a run), and one is taken a minute after the first frame for comparison.
+ * SSBU_AUTO_PROFILE=0: only L3+R3. The freeze reports' thread stacks are the port's crash log's. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+
+#include "../debug_profile.h"
+
+_Bool ps4_profile_start(double seconds, const char *reason);   /* port/ps4_profile.cpp */
+int ps4_profile_running(void);
+
+void profile_start(double seconds) {
+    if (!ps4_profile_start(seconds, "asked for (L3+R3)")) fprintf(stderr, "[profile] one is running already\n");
+    else fprintf(stderr, "[profile] sampling for %.0f s (asked for)\n", seconds);
+}
+int profile_running(void) { return ps4_profile_running(); }
+int profile_dump_threads(void (*line)(const char *text)) { (void)line; return 0; }
+
+static double now_s(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (double)ts.tv_sec + (double)ts.tv_nsec / 1e9;
+}
+
+/* (gpu_d3d11.c, at each present) */
+void hitch_present(void) {
+    static int on = -1, slow_windows, taken, baseline_done;
+    static double first, window, last_profile = -1e9;
+    static unsigned frames;
+    if (on < 0) {
+        const char *v = getenv("SSBU_AUTO_PROFILE");
+        on = !v || atoi(v) != 0;
+    }
+    if (!on) return;
+    double t = now_s();
+    if (!first) first = window = t;
+    frames++;
+    if (t - window < 1.0) return;
+    double fps = frames / (t - window);
+    frames = 0;
+    window = t;
+    slow_windows = fps < 30.0 ? slow_windows + 1 : 0;
+    char reason[96];
+    if (slow_windows >= 2 && taken < 6 && t - last_profile >= 30.0) {
+        snprintf(reason, sizeof reason, "slow: %.1f frames a second, %.0f s after the first frame", fps, t - first);
+    } else if (!baseline_done && t - first >= 60.0 && fps >= 30.0) {
+        snprintf(reason, sizeof reason, "for comparison: %.1f frames a second, %.0f s after the first frame", fps, t - first);
+        baseline_done = 1;
+    } else {
+        return;
+    }
+    if (ps4_profile_start(5.0, reason)) {
+        taken++;
+        last_profile = t;
+        slow_windows = 0;
+        fprintf(stderr, "[profile] sampling for 5 s (%s)\n", reason);
+    }
+}
diff --git a/runtime/ps4/start.c b/runtime/ps4/start.c
new file mode 100644
index 0000000..0f7a3b6
--- /dev/null
+++ b/runtime/ps4/start.c
@@ -0,0 +1,43 @@
+/* The PS4's start (host.c main, as mac_start on macOS): an eboot gets no arguments and starts in
+ * /app0, so the game's tree is /data/SSBU - dump/modules (the module images, romfs.cfg, aoc.cfg),
+ * dump/fonts, save/, reports/, screenshots/, the *.txt and *.ini settings - and the working
+ * folder is that tree, as the port's root is on the other systems. stdout and stderr go to
+ * /data/SSBU/ssbu.log (a new one each start; the last one kept as ssbu.old.log). The port's own
+ * start (ps4_port_start: the screen opened before any graphics, DXVK's settings) runs first, if
+ * it links one in. */
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define TREE "/data/SSBU"
+
+__attribute__((weak)) void ps4_port_start(void);
+
+/* (ps4_compat.h) a relative path as the tree's: the PS4 resolves no relative path */
+const char *rt_ps4_path(const char *path) {
+    static __thread char bufs[4][1024];
+    static __thread unsigned next;
+    if (!path || path[0] == '/') return path;
+    while (path[0] == '.' && path[1] == '/') path += 2;
+    char *buf = bufs[next++ % 4];
+    snprintf(buf, sizeof bufs[0], TREE "/%s", strcmp(path, ".") ? path : "");
+    return buf;
+}
+
+void ps4_start(const char **dir, int *options) {
+    mkdir(TREE, 0777);
+    rename(TREE "/ssbu.log", TREE "/ssbu.old.log");
+    int fd = open(TREE "/ssbu.log", O_WRONLY | O_CREAT | O_TRUNC, 0666);
+    if (fd >= 0) { dup2(fd, 1); dup2(fd, 2); close(fd); }
+    setvbuf(stderr, NULL, _IONBF, 0);
+    if (chdir(TREE)) fprintf(stderr, "[boot] cannot work in %s\n", TREE);
+    mkdir(TREE "/save", 0777);
+    mkdir(TREE "/reports", 0777);
+    mkdir(TREE "/screenshots", 0777);
+    if (ps4_port_start) ps4_port_start();
+    *dir = "dump/modules";
+    *options = 1;
+}
diff --git a/runtime/ps4/window.c b/runtime/ps4/window.c
new file mode 100644
index 0000000..b241467
--- /dev/null
+++ b/runtime/ps4/window.c
@@ -0,0 +1,33 @@
+/* The game's "window" on the PS4: the TV, 1920 x 1080 at 60 Hz, through VideoOut. DXVK presents
+ * there with its PS4 window system (the port's DXVK, patches/dxvk-ps4.patch: any HWND is the
+ * screen; the swapchain is the port's port/ps4_vk_wsi.cpp). There is no keyboard; the pads are
+ * hle_pad.c's (its PS4 backend). The main thread has no events to run: it waits, and prints the
+ * status when asked to. */
+#include <stdio.h>
+#include <stdlib.h>
+
+#include <windows.h>
+
+#include "../display.h"
+
+#define SCREEN ((void *)(uintptr_t)1)   /* (the HWND every swap chain is made for) */
+
+SHORT GetAsyncKeyState(int vk) { (void)vk; return 0; }
+HWND GetForegroundWindow(void) { return (HWND)SCREEN; }
+void *rt_window(void) { return SCREEN; }
+
+int rt_window_init(void) {
+    setenv("DXVK_WSI_DRIVER", "PS4", 1);
+    display_note_size(1920, 1080);
+    display_note_refresh(60);
+    fprintf(stderr, "[gfx] the screen: 1920x1080 at 60 Hz (VideoOut)\n");
+    return 1;
+}
+
+/* Runs on the main thread for good. `status` is called every `every` seconds (0: never). */
+void rt_window_loop(int every, void (*status)(void)) {
+    for (;;) {
+        Sleep(every > 0 ? (DWORD)every * 1000 : 1000);
+        if (every > 0 && status) status();
+    }
+}

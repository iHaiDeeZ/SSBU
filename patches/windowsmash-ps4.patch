+/* FSR 1 - AMD FidelityFX Super Resolution 1.0 (ffx_fsr1.h, MIT license): its edge-adaptive upscale (EASU) and
+ * its robust contrast-adaptive sharpening (RCAS), the 32-bit float paths, with a texel load for each of EASU's
+ * twelve taps in place of its gathers, and RCAS's limits kept from dividing by zero. Both work on the picture's
+ * bytes as they are: sRGB-encoded, the perceptual space FSR is made for. */
+static const char FSR_HLSL[] =
+    "Texture2D<float4> fsr_in : register(t0);\n"
+    "struct V { float4 pos : SV_Position; float2 uv : TEXCOORD0; };\n"
+    /* easu0: the output pixel to input position scale xy and offset zw (FsrEasuCon's con0); easu_max: the
+     * input's last texel. rcas0.x: the sharpening, exp2(-stops); rcas_max: the upscaled picture's last texel
+     * xy, and its place's origin in the window zw */
+    "cbuffer F : register(b4) { float4 easu0; int4 easu_max; float4 rcas0; int4 rcas_max; };\n"
+    "float3 fsr_load(int2 p, int2 last) { return fsr_in.Load(int3(clamp(p, int2(0, 0), last), 0)).rgb; }\n"
+    "float rcp_lo(float a) { return asfloat(0x7ef07ebbu - asuint(a)); }\n"
+    "float rsq_lo(float a) { return asfloat(0x5f347d74u - (asuint(a) >> 1)); }\n"
+    "float rcp_med(float a) { float b = asfloat(0x7ef19fffu - asuint(a)); return b * (-b * a + 2.0); }\n"
+    "float luma2(float3 c) { return c.b * 0.5 + (c.r * 0.5 + c.g); }\n"
+    "void easu_set(inout float2 dir, inout float len, float w, float lA, float lB, float lC, float lD, float lE) {\n"
+    "  float lenX = rcp_lo(max(abs(lD - lC), abs(lC - lB))); float dirX = lD - lB;\n"
+    "  dir.x += dirX * w; lenX = saturate(abs(dirX) * lenX); len += lenX * lenX * w;\n"
+    "  float lenY = rcp_lo(max(abs(lE - lC), abs(lC - lA))); float dirY = lE - lA;\n"
+    "  dir.y += dirY * w; lenY = saturate(abs(dirY) * lenY); len += lenY * lenY * w; }\n"
+    "void easu_tap(inout float3 aC, inout float aW, float2 off, float2 dir, float2 len, float lob, float clp, float3 c) {\n"
+    "  float2 v = float2(off.x * dir.x + off.y * dir.y, off.x * -dir.y + off.y * dir.x) * len;\n"
+    "  float d2 = min(v.x * v.x + v.y * v.y, clp);\n"
+    "  float wB = 2.0 / 5.0 * d2 - 1.0, wA = lob * d2 - 1.0;\n"
+    "  wB *= wB; wA *= wA; wB = 25.0 / 16.0 * wB - (25.0 / 16.0 - 1.0);\n"
+    "  float w = wB * wA; aC += c * w; aW += w; }\n"
+    /* EASU: the twelve texels around the output pixel's place in the picture -   b c
+     * the four nearest (f g j k) give the edge's direction and length,          e f g h
+     * the twelve a Lanczos-like kernel stretched along it                         i j k l
+     *                                                                               n o */
+    "float4 easu(V i) : SV_Target {\n"
+    "  float2 pp = floor(i.pos.xy) * easu0.xy + easu0.zw, fp = floor(pp); pp -= fp;\n"
+    "  int2 f = int2(fp), m = easu_max.xy;\n"
+    "  float3 b = fsr_load(f + int2(0, -1), m), c = fsr_load(f + int2(1, -1), m);\n"
+    "  float3 e = fsr_load(f + int2(-1, 0), m), F = fsr_load(f, m), g = fsr_load(f + int2(1, 0), m), h = fsr_load(f + int2(2, 0), m);\n"
+    "  float3 I = fsr_load(f + int2(-1, 1), m), j = fsr_load(f + int2(0, 1), m), k = fsr_load(f + int2(1, 1), m), l = fsr_load(f + int2(2, 1), m);\n"
+    "  float3 n = fsr_load(f + int2(0, 2), m), o = fsr_load(f + int2(1, 2), m);\n"
+    "  float bL = luma2(b), cL = luma2(c), eL = luma2(e), fL = luma2(F), gL = luma2(g), hL = luma2(h);\n"
+    "  float iL = luma2(I), jL = luma2(j), kL = luma2(k), lL = luma2(l), nL = luma2(n), oL = luma2(o);\n"
+    "  float2 dir = 0; float len = 0;\n"
+    "  easu_set(dir, len, (1.0 - pp.x) * (1.0 - pp.y), bL, eL, fL, gL, jL);\n"
+    "  easu_set(dir, len, pp.x * (1.0 - pp.y), cL, fL, gL, hL, kL);\n"
+    "  easu_set(dir, len, (1.0 - pp.x) * pp.y, fL, iL, jL, kL, nL);\n"
+    "  easu_set(dir, len, pp.x * pp.y, gL, jL, kL, lL, oL);\n"
+    "  float dirR = dir.x * dir.x + dir.y * dir.y; bool zro = dirR < 1.0 / 32768.0;\n"
+    "  dirR = zro ? 1.0 : rsq_lo(dirR); dir.x = zro ? 1.0 : dir.x; dir *= dirR;\n"
+    "  len = len * 0.5; len *= len;\n"
+    "  float stretch = (dir.x * dir.x + dir.y * dir.y) * rcp_lo(max(abs(dir.x), abs(dir.y)));\n"
+    "  float2 len2 = float2(1.0 + (stretch - 1.0) * len, 1.0 - 0.5 * len);\n"
+    "  float lob = 0.5 + (1.0 / 4.0 - 0.04 - 0.5) * len, clp = rcp_lo(lob);\n"
+    "  float3 aC = 0; float aW = 0;\n"
+    "  easu_tap(aC, aW, float2(0, -1) - pp, dir, len2, lob, clp, b);\n"
+    "  easu_tap(aC, aW, float2(1, -1) - pp, dir, len2, lob, clp, c);\n"
+    "  easu_tap(aC, aW, float2(-1, 1) - pp, dir, len2, lob, clp, I);\n"
+    "  easu_tap(aC, aW, float2(0, 1) - pp, dir, len2, lob, clp, j);\n"
+    "  easu_tap(aC, aW, float2(0, 0) - pp, dir, len2, lob, clp, F);\n"
+    "  easu_tap(aC, aW, float2(-1, 0) - pp, dir, len2, lob, clp, e);\n"
+    "  easu_tap(aC, aW, float2(1, 1) - pp, dir, len2, lob, clp, k);\n"
+    "  easu_tap(aC, aW, float2(2, 1) - pp, dir, len2, lob, clp, l);\n"
+    "  easu_tap(aC, aW, float2(2, 0) - pp, dir, len2, lob, clp, h);\n"
+    "  easu_tap(aC, aW, float2(1, 0) - pp, dir, len2, lob, clp, g);\n"
+    "  easu_tap(aC, aW, float2(1, 2) - pp, dir, len2, lob, clp, o);\n"
+    "  easu_tap(aC, aW, float2(0, 2) - pp, dir, len2, lob, clp, n);\n"
+    "  float3 mn = min(min(F, g), min(j, k)), mx = max(max(F, g), max(j, k));\n"
+    "  return float4(min(mx, max(mn, aC / aW)), 1); }\n"
+    /* RCAS: the cross of five pixels around each; the sharpening lobe as strong as it can be without
+     * clipping, at most FSR_RCAS_LIMIT (no denoise) */
+    "float4 rcas(V i) : SV_Target {\n"
+    "  int2 p = int2(i.pos.xy) - rcas_max.zw, m = rcas_max.xy;\n"
+    "  float3 b = fsr_load(p + int2(0, -1), m), d = fsr_load(p + int2(-1, 0), m), e = fsr_load(p, m);\n"
+    "  float3 f = fsr_load(p + int2(1, 0), m), h = fsr_load(p + int2(0, 1), m);\n"
+    "  float3 mn4 = min(min(b, d), min(f, h)), mx4 = max(max(b, d), max(f, h));\n"
+    "  float3 hitMin = min(mn4, e) / max(4.0 * mx4, 1.0 / 65536.0);\n"
+    "  float3 hitMax = (1.0 - max(mx4, e)) / min(4.0 * mn4 - 4.0, -1.0 / 65536.0);\n"
+    "  float3 lobe3 = max(-hitMin, hitMax);\n"
+    "  float lobe = max(-(0.25 - 1.0 / 16.0), min(max(lobe3.r, max(lobe3.g, lobe3.b)), 0.0)) * rcas0.x;\n"
+    "  float rcpL = rcp_med(4.0 * lobe + 1.0);\n"
+    "  return float4((lobe * b + lobe * d + lobe * h + lobe * f + e) * rcpL, 1); }\n";

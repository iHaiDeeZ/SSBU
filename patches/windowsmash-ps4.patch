--- /dev/null
+++ b/tools/ps4/build_ps4.py
@@ -0,0 +1,380 @@
+#!/usr/bin/env python3
+"""Build the game's objects for the PS4 (the SSBU port: github.com/iHaiDeeZ, E:\\PS4 Projects\\SSBU).
+
+Usage: build_ps4.py [--port <dir>] [--out <dir>] [--jobs N] [--runtime-only]
+
+As tools/linux/build_linux.py, but with the PS4 toolchain (clang 21, the OpenOrbis C library, the port's libc++
+sysroot) and for the PS4's processor (AMD Jaguar: -march=btver2, AVX but no AVX2 or FMA). The recompiled game is the
+C tools/recomp.py all --generate-only wrote into <port>/build/{main,subsdk0,sdk,nro/*}; the runtime is runtime/*.c
+with the Linux platform layer (runtime/linux, its Win32 shim) and the PS4's (runtime/ps4). Nothing is linked here:
+<out>/objects.rsp lists every object for the eboot's link (the port's ps4/CMakeLists.txt, with DXVK, RADV and the
+PS4 layer). Incremental: a file is compiled again when its source is newer than its object.
+
+Environment: OPENORBIS (/opt/pacbrew/ps4/openorbis), PS4_SYSROOT (~/ssbu-build/sysroot), CLANG_VER (21),
+DXVK_SRC (~/ssbu-build/src/dxvk: the DirectX headers), VKD3D_SRC (the vkd3d source, for its headers)."""
+import os
+import re
+import subprocess
+import sys
+import time
+from concurrent.futures import ThreadPoolExecutor, as_completed
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.dirname(os.path.dirname(HERE))
+RUNTIME = os.path.join(REPO, "runtime")
+sys.path.insert(0, os.path.join(REPO, "tools"))
+import progress  # noqa: E402
+
+
+def arg(name, default=None):
+    return sys.argv[sys.argv.index(name) + 1] if name in sys.argv else default
+
+
+HOME = os.path.expanduser("~")
+OO = os.environ.get("OPENORBIS", "/opt/pacbrew/ps4/openorbis")
+SYSROOT = os.environ.get("PS4_SYSROOT", os.path.join(HOME, "ssbu-build", "sysroot"))
+CLANG = "clang-" + os.environ.get("CLANG_VER", "21")
+DXVK_SRC = os.environ.get("DXVK_SRC", os.path.join(HOME, "ssbu-build", "src", "dxvk"))
+VKD3D_SRC = os.environ.get("VKD3D_SRC", "")
+PORT = os.path.abspath(arg("--port", REPO))
+OUT = os.path.abspath(arg("--out", os.path.join(HOME, "ssbu-build", "build", "ssbu")))
+JOBS = int(arg("--jobs", str(max(4, (os.cpu_count() or 8) - 4))))
+GEN = os.path.join(OUT, "gen")
+
+# Guest FP semantics need IEEE-exact arithmetic: no contraction, no fast-math (as on Windows and Linux).
+CFLAGS = ["--target=x86_64-pc-freebsd12-elf", "-D_GNU_SOURCE", "-D__PS4__", "-D__ORBIS__", "-D__OPENORBIS__", "-DPS4",
+          "-D__BSD_VISIBLE", "-D_BSD_SOURCE", "-fPIE", "-funwind-tables", "-fasynchronous-unwind-tables",
+          "-march=btver2", "--sysroot=" + OO, "-isystem", os.path.join(SYSROOT, "libc-overlay"),
+          "-isystem", os.path.join(OO, "include"), "-isystem", os.path.join(SYSROOT, "include"),
+          "-fno-strict-aliasing", "-ffp-contract=off", "-w", "-I", RUNTIME]
+CXXFLAGS = ["-x", "c++", "-std=gnu++20", "-fexceptions", "-nostdinc++", "-isystem",
+            os.path.join(SYSROOT, "include", "c++", "v1")]
+RUNTIME_INCLUDES = ["-I", os.path.join(RUNTIME, "ps4", "include"), "-I", os.path.join(RUNTIME, "linux", "include"),
+                    "-I", os.path.join(DXVK_SRC, "include", "native", "windows"),
+                    "-I", os.path.join(DXVK_SRC, "include", "native", "directx"),
+                    "-I", os.path.join(DXVK_SRC, "include", "vulkan", "include"), "-I", GEN]
+if VKD3D_SRC:
+    RUNTIME_INCLUDES += ["-I", os.path.join(VKD3D_SRC, "include")]
+RUNTIME_DEFINES = ["-D_REENTRANT", "-DSSBU_PS4", "-include", os.path.join(RUNTIME, "ps4", "include", "ps4_compat.h")]
+# The codecs (tools/ps4/build_codecs_ps4.py: libopus, libvpx's VP9 decoder from third_party/), linked into the eboot
+if os.path.isfile(os.path.join(REPO, "third_party", "opus", "src", "opus_decoder.c")):
+    RUNTIME_DEFINES += ["-DSSBU_HAVE_OPUS"]
+if os.path.isfile(os.path.join(REPO, "third_party", "libvpx", "vp9", "vp9_dx_iface.c")):
+    RUNTIME_DEFINES += ["-DSSBU_HAVE_VPX", "-I", os.path.join(REPO, "third_party", "libvpx")]
+# Linux layer files the PS4 does not build: the window (SDL) and the profiler (perf events): runtime/ps4's instead
+LINUX_SKIP = {"window.c", "profile.c"}
+
+
+def run(cmd):
+    r = subprocess.run(["nice", "-n", "10", *cmd], capture_output=True, text=True)
+    return r.returncode, r.stdout + r.stderr
+
+
+def compile_one(job):
+    src, obj, opt = job[:3]
+    flags = list(job[3]) if len(job) > 3 else []
+    os.makedirs(os.path.dirname(obj), exist_ok=True)
+    cxx = src.endswith((".cpp", ".cc")) or "c++" in flags
+    flags = [f for f in flags if f != "c++"]
+    code, out = run([CLANG, "-c", opt, *CFLAGS, *(CXXFLAGS if cxx else []), *flags, src, "-o", obj])
+    return (src, out) if code else None
+
+
+def needs(obj, *srcs):
+    return not os.path.exists(obj) or os.path.getmtime(obj) < max(os.path.getmtime(s) for s in srcs)
+
+
+def modules():
+    """(name, generated C directory, object directory) of every module. The NROs' objects are position-independent
+    (nro-pic/): each NRO is a library of its own (<out>/nro-so/<name>.so), loaded when the game loads the NRO."""
+    build = os.path.join(PORT, "build")
+    found = [(n, os.path.join(build, n), os.path.join(OUT, n)) for n in ("main", "subsdk0", "sdk")]
+    nro = os.path.join(build, "nro")
+    if os.path.isdir(nro):
+        found += [(n, os.path.join(nro, n), os.path.join(OUT, "nro-pic", n)) for n in sorted(os.listdir(nro))
+                  if os.path.exists(os.path.join(nro, n, "manifest.tsv"))]
+    return [m for m in found if os.path.exists(os.path.join(m[1], "manifest.tsv"))]
+
+
+def is_nro(src_dir):
+    return os.path.basename(os.path.dirname(src_dir)) == "nro"
+
+
+def has_landing_sites(path):
+    with open(path, "rb") as f:
+        return b"__try" in f.read()
+
+
+def game_jobs():
+    recomp_h = os.path.join(RUNTIME, "recomp.h")
+    jobs = []
+    for _name, src_dir, out_dir in modules():
+        nro = is_nro(src_dir)
+        with open(os.path.join(src_dir, "manifest.tsv")) as f:
+            rows = [line.split("\t") for line in f.read().splitlines() if line]
+        for fname, _insns, biggest in rows + [["g_module.c", "0", "0"]]:
+            src = os.path.join(src_dir, fname)
+            obj = os.path.join(out_dir, fname[:-2] + ".o")
+            opt = "-O1" if int(biggest) > 20000 or fname == "g_module.c" else "-O2"
+            if not needs(obj, src, recomp_h):
+                continue
+            # An NRO's library: position-independent; its guest functions hidden (calls between them direct, not
+            # through the PLT), but not its module table (rt_module_<name>: the loader looks it up) nor its C++
+            # files (their typeinfo must bind to the eboot's, which throws: runtime/ps4/elfload.c)
+            flags = ["-fPIC"] if nro else []
+            if fname != "g_module.c" and has_landing_sites(src):
+                # (as on Linux: guest try/catch as C++; the giant lua2cpp tables at -O0)
+                if int(biggest) > 50000:
+                    opt = "-O0"
+                wrapper = os.path.join(out_dir, fname[:-2] + "_cxx.cpp")
+                os.makedirs(out_dir, exist_ok=True)
+                text = '#include "recomp.h"\nextern "C" {\n#include "%s"\n}\n' % src
+                if not os.path.exists(wrapper) or open(wrapper).read() != text:
+                    with open(wrapper, "w") as f:
+                        f.write(text)
+                jobs.append((wrapper, obj, opt, flags))
+            else:
+                jobs.append((src, obj, opt, flags + (["-fvisibility=hidden"] if nro and fname != "g_module.c" else [])))
+    return jobs
+
+
+def hle_names():
+    names = set()
+    for n in os.listdir(RUNTIME):
+        if n.endswith(".c"):
+            with open(os.path.join(RUNTIME, n), encoding="utf-8") as f:
+                names |= set(re.findall(r"^HLE\((\w+)\)", f.read(), re.M))
+    return sorted(names)
+
+
+def hle_wraps():
+    found = set()
+    for n in os.listdir(RUNTIME):
+        if n.endswith(".c"):
+            with open(os.path.join(RUNTIME, n), encoding="utf-8") as f:
+                found |= {int(a, 16) for a in re.findall(r"^HLE_WRAP\(([0-9a-fA-F]+)\)", f.read(), re.M)}
+    return sorted(found)
+
+
+def write_if_changed(path, text):
+    if os.path.exists(path) and open(path, encoding="utf-8").read() == text:
+        return False
+    with open(path, "w", encoding="utf-8", newline="\n") as f:
+        f.write(text)
+    return True
+
+
+def overlay_font():
+    """gen/overlay_font.h, drawn as on Linux (tools/linux/make_overlay_font.py, Pillow and a monospace font)."""
+    os.makedirs(GEN, exist_ok=True)
+    header = os.path.join(GEN, "overlay_font.h")
+    tool = os.path.join(REPO, "tools", "linux", "make_overlay_font.py")
+    if not needs(header, tool):
+        return
+    r = subprocess.run(["python3", tool, header], capture_output=True, text=True)
+    if r.returncode:
+        print("could not draw the overlay font: the overlay shows no text\n" + (r.stdout + r.stderr).strip())
+        with open(header, "w", newline="\n") as f:
+            f.write("static const unsigned char overlay_font[%d] = {0};\n" % (24 * 16 * 48 * 6))
+
+
+def runtime_sources():
+    sources = [os.path.join(RUNTIME, n) for n in sorted(os.listdir(RUNTIME))
+               if re.fullmatch(r"(host|kernel|gpu\w*|hle\w*|ipc\w*|net\w*|debug_watchdog)\.c", n)]
+    sources += [os.path.join(RUNTIME, "linux", n) for n in sorted(os.listdir(os.path.join(RUNTIME, "linux")))
+                if n.endswith((".c", ".cpp")) and n not in LINUX_SKIP and not (n == "d3dcompile_vkd3d.c" and not VKD3D_SRC)]
+    sources += [os.path.join(RUNTIME, "ps4", n) for n in sorted(os.listdir(os.path.join(RUNTIME, "ps4")))
+                if n.endswith((".c", ".cpp"))]
+    return sources
+
+
+def runtime_jobs():
+    os.makedirs(GEN, exist_ok=True)
+    rt_out = os.path.join(OUT, "rt")
+    headers = [os.path.join(RUNTIME, n) for n in os.listdir(RUNTIME) if n.endswith(".h")]
+    for d in ("linux/include", "ps4/include", "ps4"):
+        p = os.path.join(RUNTIME, d)
+        if os.path.isdir(p):
+            headers += [os.path.join(p, n) for n in os.listdir(p) if n.endswith(".h")]
+    flags = RUNTIME_INCLUDES + RUNTIME_DEFINES
+    jobs = []
+    for src in runtime_sources():
+        obj = os.path.join(rt_out, os.path.basename(src).rsplit(".", 1)[0] + ".o")
+        if needs(obj, src, *headers):
+            jobs.append((src, obj, "-O2", flags))
+    names = hle_names()
+    table = os.path.join(GEN, "hle_table.c")
+    changed = write_if_changed(table, '#include "host.h"\n\n' + "".join(f"GuestFn hle_{n};\n" for n in names)
+                               + "const HleEntry hle_table[] = {\n" + "".join(f'    {{"{n}", hle_{n}}},\n' for n in names)
+                               + f"    {{0, 0}}\n}};\nconst u32 hle_count = {len(names)};\n")
+    if changed or needs(os.path.join(rt_out, "hle_table.o"), table, *headers):
+        jobs.append((table, os.path.join(rt_out, "hle_table.o"), "-O1", flags))
+    missing = os.path.join(GEN, "wrap_missing.c")
+    changed = write_if_changed(missing, '#include "host.h"\n\nvoid rt_wrap_missing(Cpu *c);\n'
+                               + "".join(f"__attribute__((weak)) void f_{a:x}_orig(Cpu *c) {{ rt_wrap_missing(c); }}\n"
+                                         for a in hle_wraps()))
+    if changed or needs(os.path.join(rt_out, "wrap_missing.o"), missing, *headers):
+        jobs.append((missing, os.path.join(rt_out, "wrap_missing.o"), "-O1", flags))
+    nro_table = os.path.join(GEN, "nro_table.c")
+    changed = write_if_changed(nro_table, nro_stubs())
+    if changed or needs(os.path.join(rt_out, "nro_table.o"), nro_table):
+        jobs.append((nro_table, os.path.join(rt_out, "nro_table.o"), "-O1", ["-I", RUNTIME]))
+    return jobs
+
+
+MODULE_RE = re.compile(r'const RtModule rt_module_(\w+) = \{\s*"([^"]*)", (0x[0-9A-Fa-f]+)ull, (0x[0-9A-Fa-f]+)ull, '
+                       r'(0x[0-9A-Fa-f]+)ull, (0x[0-9A-Fa-f]+)ull,\s*funcs, (\d+), exports, (\d+), imports, import_weak, '
+                       r'(\d+), relocs, (\d+), (NULL|0|"[0-9A-Fa-f]*"),?\s*\};')
+
+
+def nro_info(src_dir):
+    """An NRO's module table (rt_module_<name> in its g_module.c, the last thing there): name, base, sizes, init,
+    counts, build id."""
+    with open(os.path.join(src_dir, "g_module.c"), "rb") as f:
+        f.seek(0, 2)
+        f.seek(max(0, f.tell() - 4096))
+        tail = f.read().decode("utf-8", "replace")
+    m = MODULE_RE.search(tail)
+    if not m:
+        raise SystemExit(f"{src_dir}/g_module.c: no module table at its end")
+    return m.groups()
+
+
+def nro_stubs():
+    """The NROs as the eboot knows them: each module table without its code (functions, exports, imports,
+    relocations: in the NRO's library, runtime/ps4/elfload.c loads it with nn::ro, host.c rt_load_nro), so that
+    start-up can reserve their ranges and size the symbol table. The counts are kept: load() adds up the exports."""
+    out = ['#include "module.h"\n']
+    names = []
+    for n, src, _o in modules():
+        if not is_nro(src):
+            continue
+        sym, name, base, image, text, init, funcs, exports, imports, relocs, build_id = nro_info(src)
+        names.append(sym)
+        out.append(f'const RtModule rt_module_{sym} = {{"{name}", {base}ull, {image}ull, {text}ull, {init}ull, '
+                   f'0, {funcs}, 0, {exports}, 0, 0, {imports}, 0, {relocs}, {build_id}}};\n')
+    out.append("const RtModule *const rt_nro_modules[] = {" + "".join(f"&rt_module_{n}, " for n in names) + "0};\n")
+    out.append(f"const u32 rt_nro_count = {len(names)};\n")
+    return "".join(out)
+
+
+def link_nros():
+    """<out>/nro-so/<name>.so for each NRO whose objects are newer: a shared library (position-independent,
+    16 KiB pages, a SysV hash table: runtime/ps4/elfload.c reads it), its outside references left undefined
+    (the eboot's exports bind them at load: gen/ps4_exports.c)."""
+    so_dir = os.path.join(OUT, "nro-so")
+    os.makedirs(so_dir, exist_ok=True)
+    jobs = []
+    for n, src, obj_dir in modules():
+        if not is_nro(src) or not os.path.isdir(obj_dir):
+            continue
+        objs = sorted(os.path.join(obj_dir, f) for f in os.listdir(obj_dir) if f.endswith(".o"))
+        so = os.path.join(so_dir, n + ".so")
+        if objs and needs(so, *objs):
+            jobs.append((n, so, objs))
+
+    def one(job):
+        n, so, objs = job
+        code, out = run(["ld.lld-21", "-shared", "-m", "elf_x86_64", "--hash-style=sysv", "-z", "max-page-size=0x4000",
+                         "-z", "noexecstack", "--eh-frame-hdr", "-soname", n + ".so", "-o", so, *objs])
+        return (n, out) if code else None
+    t0 = time.time()
+    with ThreadPoolExecutor(JOBS) as pool:
+        failures = [f for f in pool.map(one, jobs) if f]
+    for n, err in failures[:8]:
+        print(f"FAILED linking {n}.so:\n{err[:3000]}")
+    if jobs:
+        print(f"NRO libraries: {len(jobs)} linked, {len(failures)} failed, {time.time() - t0:,.0f}s")
+    return not failures
+
+
+def exports():
+    """gen/ps4_exports.c: the eboot's symbols the NRO libraries refer to (their undefined ones: the runtime's
+    rt_lookup and friends, the C++ exception runtime, memset), and the C++ typeinfo they define themselves too -
+    the eboot's copy wins (it throws: a catch matches by the typeinfo's address), as an executable's symbol
+    would in a dynamic link. Sorted by name: runtime/ps4/elfload.c looks them up by bisection."""
+    so_dir = os.path.join(OUT, "nro-so")
+    sos = sorted(os.path.join(so_dir, f) for f in os.listdir(so_dir) if f.endswith(".so"))
+    undefined, typeinfo = set(), set()
+    for so in sos:
+        r = subprocess.run(["llvm-nm-21", "-D", so], capture_output=True, text=True)
+        for line in r.stdout.splitlines():
+            parts = line.split()
+            if len(parts) == 2 and parts[0] in ("U", "w"):
+                undefined.add(parts[1])
+            elif len(parts) == 3 and parts[1] in ("V", "W", "R", "D") and parts[2].startswith(("_ZTI", "_ZTS", "_ZTV")):
+                typeinfo.add(parts[2])
+    names = sorted(undefined | typeinfo)
+    text = ["/* (tools/ps4/build_ps4.py: what the NRO libraries take from the eboot) */\n",
+            "typedef struct Ps4Export { const char *name; const void *addr; } Ps4Export;\n"]
+    for i, n in enumerate(names):   # (by their assembler names: memset and the like are C's own otherwise)
+        weak = n in typeinfo and n not in undefined
+        text.append(f"{'__attribute__((weak)) ' if weak else ''}extern char x{i}[] __asm__(\"{n}\");\n")
+    text.append("const Ps4Export ps4_exports[] = {\n" + "".join(f'    {{"{n}", x{i}}},\n' for i, n in enumerate(names)) + "};\n")
+    text.append(f"const unsigned ps4_export_count = {len(names)};\n")
+    path = os.path.join(GEN, "ps4_exports.c")
+    obj = os.path.join(OUT, "rt", "ps4_exports.o")
+    if write_if_changed(path, "".join(text)) or needs(obj, path):
+        if not compile_all([(path, obj, "-O1", [])], "exports"):
+            return False
+    print(f"eboot exports for the NRO libraries: {len(names)} ({len(typeinfo)} typeinfo)")
+    return True
+
+
+def in_order(jobs):
+    def source_size(job):
+        src = job[0]
+        if src.endswith("_cxx.cpp"):
+            src = re.findall(r'#include "([^"]+)"', open(src).read())[-1]
+        return os.path.getsize(src)
+    return sorted(jobs, key=source_size, reverse=True)
+
+
+def compile_all(jobs, what):
+    if not jobs:
+        print(f"{what}: up to date")
+        return True
+    t0 = time.time()
+    failures = []
+    with ThreadPoolExecutor(JOBS) as pool:
+        futures = [pool.submit(compile_one, job) for job in in_order(jobs)]
+        for done, fut in enumerate(as_completed(futures), 1):
+            r = fut.result()
+            if r:
+                failures.append(r)
+            if done % 64 == 0 or done == len(jobs):
+                print(f"{what}: {done}/{len(jobs)} compiled, {len(failures)} failed, {time.time() - t0:,.0f}s", flush=True)
+    for src, err in failures[:12]:
+        print(f"FAILED {src}:\n{err[:4000]}")
+    return not failures
+
+
+def write_objects():
+    """<out>/objects.rsp (every object, for the eboot's link) and the size of the code."""
+    objs = sorted(os.path.join(OUT, "rt", n) for n in os.listdir(os.path.join(OUT, "rt")) if n.endswith(".o"))
+    for _name, src, out_dir in modules():   # (the NROs are libraries of their own: link_nros)
+        if os.path.isdir(out_dir) and not is_nro(src):
+            objs += sorted(os.path.join(out_dir, n) for n in os.listdir(out_dir) if n.endswith(".o"))
+    with open(os.path.join(OUT, "objects.rsp"), "w", newline="\n") as f:
+        f.write("\n".join(objs) + "\n")
+    print(f"{len(objs)} objects, {sum(os.path.getsize(o) for o in objs) / 1048576:,.0f} MB: {os.path.join(OUT, 'objects.rsp')}")
+
+
+def main():
+    os.makedirs(OUT, exist_ok=True)
+    overlay_font()
+    if not compile_all(runtime_jobs(), "runtime"):
+        return False
+    if "--runtime-only" not in sys.argv:
+        if not modules():
+            raise SystemExit(f"no recompiled game in {os.path.join(PORT, 'build')} (tools/recomp.py all --generate-only)")
+        if not compile_all(game_jobs(), "game"):
+            return False
+        if not link_nros() or not exports():
+            return False
+    write_objects()
+    return True
+
+
+if __name__ == "__main__":
+    sys.exit(0 if main() else 1)

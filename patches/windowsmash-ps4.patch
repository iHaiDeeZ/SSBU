+static u32 pack_count;
+
+/* With a pack (below), what is compiled since goes to a folder of its own beside the folder, "<cache dir>-new": a
+ * look-up in it is quick, and its files are few enough to take to the PC for the next pack - the console's FTP
+ * server gave up listing the 45,000-file folder. */
+static const char *new_dir(void) {
+    static char dir[1100];
+    if (!dir[0]) {
+        snprintf(dir, sizeof dir, "%s-new", cache_dir());
+        CreateDirectoryA(dir, NULL);
+    }
+    return dir;
+}
+
+static void new_path(const Shader *s, char *path, size_t n) {
+    shader_cache_file(path, n, new_dir(), s->stage, s->hash, s->vs_outputs, s->table_hash);
+}

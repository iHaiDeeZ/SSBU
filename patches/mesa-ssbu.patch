diff --git a/src/amd/common/ac_ps4_info.h b/src/amd/common/ac_ps4_info.h
new file mode 100644
index 0000000..b4e90f8
--- /dev/null
+++ b/src/amd/common/ac_ps4_info.h
@@ -0,0 +1,196 @@
+/*
+ * The PS4's GPU ("Liverpool", GCN gfx7) as the amdgpu kernel would describe it: the answers of the
+ * PS4 layer's queries (ac_ps4_drm.c), shared with a PC build of RADV that fills the PS4's shader
+ * cache ahead of time (AC_PS4_HOST_IDENTITY in ac_linux_drm.c). A cache entry is only found again
+ * on the console if the PC saw the very same device: what it hashes into the cache keys, and what
+ * the compiler is told (address32_hi, the CU and register counts), come from here.
+ *
+ * Copyright 2026 DolphinPS4. SPDX-License-Identifier: MIT
+ */
+
+#ifndef AC_PS4_INFO_H
+#define AC_PS4_INFO_H
+
+#include "ac_linux_drm.h"
+#include "addrlib/src/amdgpu_asic_addr.h"
+#include "util/os_time.h"
+#include "util/u_math.h"
+
+#include <errno.h>
+#include <string.h>
+
+#define AC_PS4_VRAM_SIZE (2048ull << 20)
+#define AC_PS4_GTT_SIZE (1024ull << 20)
+#define AC_PS4_PAGE 0x4000ull         /* direct memory and mapping granularity */
+#define AC_PS4_VA_SIZE 0x0400000000ull /* the GPU VA window: 16 GiB */
+#define AC_PS4_DRM_MAJOR 3
+#define AC_PS4_DRM_MINOR 61
+#define AC_PS4_MARKETING_NAME "AMD Liverpool (PS4)"
+#define AC_PS4_FW_VERSION 0x1000 /* recent CIK microcode, for every firmware asked about */
+#define AC_PS4_FW_FEATURE 0x40
+
+/* Liverpool GB_TILE_MODE0..31 and GB_MACROTILE_MODE0..15, rebuilt from shadPS4's per-mode
+ * attributes (8 pipes P8_32x32_16x16, 16 banks), and GB_ADDR_CONFIG: 8 pipes, 256 B pipe
+ * interleave, 2 shader engines, 1 KiB DRAM rows. */
+static const uint32_t ac_ps4_tile_modes[32] = {
+   0x00800310, 0x00800b10, 0x00801310, 0x00801b10, 0x00802310, 0x00800308, 0x00801318,
+   0x00802318, 0x00000304, 0x00000308, 0x02000310, 0x02000294, 0x02000318, 0x00400308,
+   0x02400310, 0x024002b0, 0x02400294, 0x02400318, 0x0240032c, 0x0100030c, 0x0100031c,
+   0x010002b4, 0x010002a4, 0x01000328, 0x010002bc, 0x01000320, 0x010002b8, 0, 0, 0, 0, 0,
+};
+static const uint32_t ac_ps4_macrotile_modes[16] = {
+   0xe8, 0xd4, 0xd0, 0xd0, 0x80, 0x40, 0x00, 0x00, 0xec, 0xe8, 0xd4, 0xd0, 0x80, 0x40, 0x00, 0x00,
+};
+#define AC_PS4_GB_ADDR_CONFIG 0x00011003
+#define AC_PS4_MC_ARB_RAMCFG 0x2 /* 16 banks */
+
+static inline void
+ac_ps4_gpu_info(struct amdgpu_gpu_info *info)
+{
+   memset(info, 0, sizeof(*info));
+   info->asic_id = 0x9920; /* Liverpool */
+   info->chip_external_rev = 0x14; /* Bonaire range: identified as CHIP_BONAIRE (gfx7) */
+   info->family_id = FAMILY_CI;
+   info->ids_flags = AMDGPU_IDS_FLAGS_FUSION;
+   info->max_engine_clk = 800000;
+   info->max_memory_clk = 1375000;
+   info->num_shader_engines = 2;
+   info->num_shader_arrays_per_engine = 1;
+   info->rb_pipes = 8;
+   info->enabled_rb_pipes_mask = 0xff;
+   info->gpu_counter_freq = 100000; /* kHz */
+   info->mc_arb_ramcfg = AC_PS4_MC_ARB_RAMCFG;
+   info->gb_addr_cfg = AC_PS4_GB_ADDR_CONFIG;
+   memcpy(info->gb_tile_mode, ac_ps4_tile_modes, sizeof(ac_ps4_tile_modes));
+   memcpy(info->gb_macro_tile_mode, ac_ps4_macrotile_modes, sizeof(ac_ps4_macrotile_modes));
+   info->cu_bitmap[0][0] = 0x1ff; /* 9 CUs per shader engine, 18 total */
+   info->cu_bitmap[1][0] = 0x1ff;
+   info->vram_type = AMDGPU_VRAM_TYPE_GDDR5;
+   info->vram_bit_width = 256;
+}
+
+/* va_start: the GPU VA window's start (the console reserves it at startup) */
+static inline void
+ac_ps4_dev_info(struct drm_amdgpu_info_device *d, uint64_t va_start)
+{
+   memset(d, 0, sizeof(*d));
+   d->device_id = 0x9920;
+   d->external_rev = 0x14;
+   d->family = FAMILY_CI;
+   d->num_shader_engines = 2;
+   d->num_shader_arrays_per_engine = 1;
+   d->gpu_counter_freq = 100000;
+   d->max_engine_clock = 800000;
+   d->max_memory_clock = 1375000;
+   d->cu_active_number = 18;
+   d->cu_bitmap[0][0] = 0x1ff;
+   d->cu_bitmap[1][0] = 0x1ff;
+   d->enabled_rb_pipes_mask = 0xff;
+   d->num_rb_pipes = 8;
+   d->num_hw_gfx_contexts = 8;
+   d->ids_flags = AMDGPU_IDS_FLAGS_FUSION;
+   d->virtual_address_offset = va_start;
+   d->virtual_address_max = va_start + AC_PS4_VA_SIZE;
+   d->virtual_address_alignment = AC_PS4_PAGE;
+   d->pte_fragment_size = AC_PS4_PAGE;
+   d->gart_page_size = 4096;
+   d->vram_type = AMDGPU_VRAM_TYPE_GDDR5;
+   d->vram_bit_width = 256;
+   d->wave_front_size = 64;
+   d->num_shader_visible_vgprs = 256;
+   d->num_cu_per_sh = 9;
+   d->num_tcc_blocks = 8;
+   d->gs_vgt_table_depth = 32;
+   d->gs_prim_buffer_depth = 1792;
+   d->max_gs_waves_per_vgt = 32;
+}
+
+static inline int
+ac_ps4_query_info(unsigned info_id, unsigned size, void *value, uint64_t va_start)
+{
+   memset(value, 0, size);
+   switch (info_id) {
+   case AMDGPU_INFO_DEV_INFO: {
+      struct drm_amdgpu_info_device d;
+      ac_ps4_dev_info(&d, va_start);
+      memcpy(value, &d, MIN2(size, sizeof(d)));
+      return 0;
+   }
+   case AMDGPU_INFO_MEMORY: {
+      struct drm_amdgpu_memory_info m = {0};
+      m.vram.total_heap_size = m.vram.usable_heap_size = AC_PS4_VRAM_SIZE;
+      m.vram.max_allocation = AC_PS4_VRAM_SIZE;
+      m.cpu_accessible_vram = m.vram;
+      m.gtt.total_heap_size = m.gtt.usable_heap_size = AC_PS4_GTT_SIZE;
+      m.gtt.max_allocation = AC_PS4_GTT_SIZE;
+      memcpy(value, &m, MIN2(size, sizeof(m)));
+      return 0;
+   }
+   case AMDGPU_INFO_VRAM_GTT: {
+      struct drm_amdgpu_info_vram_gtt v = {AC_PS4_VRAM_SIZE, AC_PS4_VRAM_SIZE, AC_PS4_GTT_SIZE};
+      memcpy(value, &v, MIN2(size, sizeof(v)));
+      return 0;
+   }
+   case AMDGPU_INFO_MAX_IBS: {
+      uint32_t *max = value;
+      if (size >= 4)
+         max[AMDGPU_HW_IP_GFX] = 32;
+      return 0;
+   }
+   case AMDGPU_INFO_TIMESTAMP:
+      if (size >= 8)
+         *(uint64_t *)value = os_time_get_nano() / 10; /* 100 MHz */
+      return 0;
+   case AMDGPU_INFO_VRAM_USAGE:
+   case AMDGPU_INFO_GTT_USAGE:
+   case AMDGPU_INFO_VIS_VRAM_USAGE:
+   case AMDGPU_INFO_NUM_EVICTIONS:
+   case AMDGPU_INFO_NUM_BYTES_MOVED:
+   case AMDGPU_INFO_NUM_VRAM_CPU_PAGE_FAULTS:
+      return 0;
+   default:
+      return -EINVAL;
+   }
+}
+
+static inline int
+ac_ps4_read_mm_registers(unsigned dword_offset, unsigned count, uint32_t *values)
+{
+   for (unsigned i = 0; i < count; i++) {
+      const unsigned reg = dword_offset + i;
+      if (reg >= 0x2644 && reg < 0x2644 + 32)
+         values[i] = ac_ps4_tile_modes[reg - 0x2644];
+      else if (reg >= 0x2664 && reg < 0x2664 + 16)
+         values[i] = ac_ps4_macrotile_modes[reg - 0x2664];
+      else if (reg == 0x263e)
+         values[i] = AC_PS4_GB_ADDR_CONFIG;
+      else
+         return -EINVAL;
+   }
+   return 0;
+}
+
+/* Only the graphics ring: GNM's compute queues and SDMA aren't exposed. */
+static inline int
+ac_ps4_hw_ip_info(unsigned type, struct drm_amdgpu_info_hw_ip *info)
+{
+   if (type != AMDGPU_HW_IP_GFX)
+      return -EINVAL;
+   memset(info, 0, sizeof(*info));
+   info->hw_ip_version_major = 7;
+   info->hw_ip_version_minor = 0;
+   info->ib_start_alignment = 32;
+   info->ib_size_alignment = 32;
+   info->available_rings = 1;
+   return 0;
+}
+
+static inline void
+ac_ps4_heap_info(uint32_t heap, struct amdgpu_heap_info *info)
+{
+   memset(info, 0, sizeof(*info));
+   info->heap_size = heap == AMDGPU_GEM_DOMAIN_VRAM ? AC_PS4_VRAM_SIZE : AC_PS4_GTT_SIZE;
+   info->max_allocation = info->heap_size;
+}
+
+#endif /* AC_PS4_INFO_H */
